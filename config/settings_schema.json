[
  {
    "name": "theme_info",
    "theme_name": "Lumière",
    "theme_version": "1.0.0",
    "theme_author": "Profit Pages",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Getting started",
    "settings": [
      {
        "type": "paragraph",
        "content": "Welcome to Lumière. These steps make your store match the demo:"
      },
      {
        "type": "header",
        "content": "1. Menus"
      },
      {
        "type": "paragraph",
        "content": "Online Store › Navigation: build a Main menu (e.g. Shop, New arrivals, Rituals, About) and footer menus (Shop, Lumière, Follow). Nested links become dropdowns."
      },
      {
        "type": "header",
        "content": "2. Beauty product details"
      },
      {
        "type": "paragraph",
        "content": "Settings › Custom data › Products: add the optional metafields custom.subtitle, custom.badge, custom.highlights (list), custom.ingredients, custom.how_to_use, custom.skin_type (list), custom.size, custom.usage_note and custom.option_note. Connect them with the dynamic-source button."
      },
      {
        "type": "header",
        "content": "3. Filters & routines"
      },
      {
        "type": "paragraph",
        "content": "Install Shopify Search & Discovery to add collection filters and to pick complementary products for 'Pairs beautifully with'."
      },
      {
        "type": "header",
        "content": "4. Reviews"
      },
      {
        "type": "paragraph",
        "content": "Install a reviews app (Judge.me, Okendo, Shopify Product Reviews…). Ratings appear automatically; add the app block to the Reviews section on product pages."
      }
    ]
  },
  {
    "name": "Logo & favicon",
    "settings": [
