        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Leave empty to show your store name as a wordmark."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 260,
        "step": 5,
        "unit": "px",
        "label": "Logo width",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "logo_inverse",
        "label": "Logo on dark backgrounds",
        "info": "Used in dark color schemes, e.g. a dark footer."
      },
      {
        "type": "select",
        "id": "wordmark_style",
        "label": "Wordmark style (when no logo)",
