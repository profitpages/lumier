  {
    "name": "Typography",
    "settings": [
      {
        "type": "checkbox",
        "id": "use_signature_fonts",
        "label": "Use Lumière fonts (Fraunces + DM Sans)",
        "default": true,
        "info": "Loaded from Google Fonts. Untick to use the Shopify font pickers below."
