<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_schemes['scheme-1'].settings.background | default: '#f8f4ed' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %}{% assign tag_list = current_tags | join: ', ' %} &ndash; {{ 'general.tagged_with' | t: tags: tag_list }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- render 'theme-styles' -%}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'section-addons.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pp-addons.js' | asset_url }}" defer="defer"></script>

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          addToCart: {{ 'products.add_to_cart' | t | json }},
          added: {{ 'products.added' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          saveAmount: {{ 'products.save_percent' | t: percent: '[percent]' | json }},
          error: {{ 'general.error' | t | json }},
          copied: {{ 'general.link_copied' | t | json }}
        }
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="color-scheme-1 template-{{ template.name | handle }}{% if settings.reveal_enable %} has-reveal{% endif %}{% if settings.float_enable %} has-float{% endif %}{% unless settings.decor_enable %} no-decor{% endunless %}{% if settings.grain_enable %} has-grain{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}
    <dialog class="qa-dialog color-scheme-2" aria-label="{{ 'products.quick_add' | t }}" data-quick-add-dialog>
      <button class="icon-btn icon-btn--ring qa-dialog__close" type="button" data-quick-add-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close', size: 20 %}</button>
      <div data-quick-add-body></div>
    </dialog>

    {%- if settings.predictive_search -%}
      {%- render 'search-modal' -%}
    {%- endif -%}

    <div class="toast" role="status" aria-live="polite" data-toast></div>
  </body>
</html>
