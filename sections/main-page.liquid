<section class="section section--tight color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow">
    {%- if section.settings.show_title -%}
      <header class="page-head">
        {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
        <h1 class="h1">{{ page.title | escape }}</h1>
      </header>
    {%- endif -%}
    <div class="rte rte--page">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "class": "section-main-page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:sections.main-page.settings.show_title.label",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.main-page.settings.kicker.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-page.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
