{%- assign s = section.settings -%}
<section class="section section--tight color-{{ s.color_scheme }}" style="--cols: 4; --cols-m: 2;">
  <div class="page-width">
    <header class="search-head">
      <p class="kicker">{{ 'search.kicker' | t }}</p>
      <h1 class="h1">{%- if search.performed -%}{{ 'search.results_for' | t: terms: search.terms }}{%- else -%}{{ 'search.title' | t }}{%- endif -%}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-head__form">
        <div class="field-icon">
          {%- render 'icon', name: 'search', size: 20 -%}
          <label class="visually-hidden" for="SearchPage">{{ 'search.placeholder' | t }}</label>
          <input class="input input--lg" id="SearchPage" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
        </div>
        <input type="hidden" name="options[prefix]" value="last">
        <button class="btn btn--solid" type="submit">{{ 'general.search' | t }}</button>
      </form>
      {%- if search.performed -%}<p class="search-head__count" role="status">{{ 'search.results_count' | t: count: search.results_count }}</p>{%- endif -%}
      {%- if s.suggestions != blank -%}
        <div class="search-head__suggest">
          <span>{{ 'search.popular' | t }}</span>
          <ul class="chip-row" role="list">
            {%- assign terms = s.suggestions | split: ',' -%}
            {%- for term in terms -%}{%- assign tt = term | strip -%}<li><a class="chip" href="{{ routes.search_url }}?q={{ tt | url_encode }}">{{ tt | escape }}</a></li>{%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </header>

    {%- if search.performed -%}
      {%- paginate search.results by s.per_page -%}
        {%- if search.results_count > 0 -%}
          <ul class="product-grid" role="list">
            {%- for item in search.results -%}
              <li class="product-grid__item">
                {%- case item.object_type -%}
                  {%- when 'product' -%}
                    {%- render 'product-card', product: item, section_id: section.id, show_quick_add: true -%}
                  {%- when 'article' -%}
                    {%- render 'article-card', article: item, show_date: true, show_excerpt: true -%}
                  {%- else -%}
                    <a class="result-card" href="{{ item.url }}">
                      <span class="kicker">{{ 'search.page' | t }}</span>
                      <span class="result-card__title">{{ item.title | escape }}</span>
                      <span class="result-card__text">{{ item.content | strip_html | truncatewords: 18 }}</span>
                    </a>
                {%- endcase -%}
              </li>
            {%- endfor -%}
          </ul>
          {%- render 'pagination', paginate: paginate -%}
        {%- else -%}
          <div class="empty">
            <div class="empty__art">{%- render 'cosmetic-art', name: 'swatch', tone: 'blush' -%}</div>
            <h2 class="h3">{{ 'search.no_results' | t: terms: search.terms }}</h2>
            <p>{{ 'search.no_results_tip' | t }}</p>
            <a class="btn btn--solid" href="{{ routes.all_products_collection_url }}">{{ 'general.shop_all' | t }}</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "class": "section-main-search",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Results per page", "min": 8, "max": 36, "step": 4, "default": 16 },
    { "type": "text", "id": "suggestions", "label": "Popular searches", "default": "serum, hydration, SPF, lip oil", "info": "Comma separated." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
