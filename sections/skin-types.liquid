{%- comment -%}
  Skin types. On product pages it can read custom.skin_type (list of text) and highlight matching cards;
  non-matching types are shown dimmed. Without the metafield, all cards display normally.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign matched = ''
  if s.use_metafield and product
    assign mf = product.metafields.custom.skin_type.value
    if mf != blank
      assign matched = mf | join: '|' | downcase
      assign matched = '|' | append: matched | append: '|'
    endif
  endif
-%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: 'center' -%}
    <ul class="skin-types" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign key = block.settings.label | downcase | strip
          assign needle = '|' | append: key | append: '|'
          assign state = ''
          if matched != blank
            if matched contains needle
              assign state = 'is-match'
            else
              assign state = 'is-dim'
            endif
          endif
        -%}
        <li class="skin {{ state }}" {{ block.shopify_attributes }}>
          <span class="skin__icon">{%- render 'icon', name: block.settings.icon, size: 26 -%}</span>
          <span class="skin__label">{{ block.settings.label | escape }}</span>
          {%- if block.settings.text != blank -%}<span class="skin__text">{{ block.settings.text | escape }}</span>{%- endif -%}
          {%- if state == 'is-match' -%}<span class="skin__check">{% render 'icon', name: 'check', size: 14 %}<span class="visually-hidden">{{ 'products.suitable' | t }}</span></span>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.skin-types.name",
  "class": "section-skin-types",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.skin-types.settings.kicker.label",
      "default": "Made for"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.skin-types.settings.heading.label",
      "default": "Every skin type, gently."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.skin-types.settings.text.label"
    },
    {
      "type": "checkbox",
      "id": "use_metafield",
      "label": "t:sections.skin-types.settings.use_metafield.label",
      "default": true,
      "info": "t:sections.skin-types.settings.use_metafield.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.skin-types.settings.color_scheme.label",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "type",
      "name": "t:sections.skin-types.blocks.type.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.skin-types.blocks.type.settings.icon.label",
          "options": [
            {
              "value": "drop",
              "label": "t:sections.skin-types.blocks.type.settings.icon.options__1.label"
            },
            {
              "value": "sun",
              "label": "t:sections.skin-types.blocks.type.settings.icon.options__2.label"
            },
            {
              "value": "leaf",
              "label": "t:sections.skin-types.blocks.type.settings.icon.options__3.label"
            },
            {
              "value": "flower",
              "label": "t:sections.skin-types.blocks.type.settings.icon.options__4.label"
            },
            {
              "value": "sparkle",
              "label": "t:sections.skin-types.blocks.type.settings.icon.options__5.label"
            },
            {
              "value": "heart",
              "label": "t:sections.skin-types.blocks.type.settings.icon.options__6.label"
            },
            {
              "value": "moon",
              "label": "t:sections.skin-types.blocks.type.settings.icon.options__7.label"
            }
          ],
          "default": "drop"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.skin-types.blocks.type.settings.label.label",
          "default": "Dry"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.skin-types.blocks.type.settings.text.label",
          "default": "Craves cushion"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.skin-types.presets.presets__1.name",
      "blocks": [
        {
          "type": "type",
          "settings": {
            "icon": "drop",
            "label": "Dry",
            "text": "Craves cushion"
          }
        },
        {
          "type": "type",
          "settings": {
            "icon": "sun",
            "label": "Oily",
            "text": "Needs balance"
          }
        },
        {
          "type": "type",
          "settings": {
            "icon": "leaf",
            "label": "Combination",
            "text": "Wants both"
          }
        },
        {
          "type": "type",
          "settings": {
            "icon": "heart",
            "label": "Sensitive",
            "text": "Loves gentle"
          }
        },
        {
          "type": "type",
          "settings": {
            "icon": "sparkle",
            "label": "Normal",
            "text": "Keeps it simple"
          }
        }
      ]
    }
  ]
}
{% endschema %}
