{%- comment -%}
  Promotional cards ("A little more to love") or a single editorial banner (image + colored panel).
{%- endcomment -%}
{{ 'section-promo.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
{%- assign arts = 'jar,serum,compact' | split: ',' -%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading -%}
    <div class="promos" style="--cols: {{ section.blocks.size | at_most: 3 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="promo-card promo-card--{{ b.layout }} color-{{ b.color_scheme }}" data-reveal {{ block.shopify_attributes }}>
          <div class="promo-card__media">
            {%- render 'responsive-image', image: b.image, max: 1200, sizes: '(min-width: 990px) 40vw, 92vw', class: 'promo-card__img', art: arts[forloop.index0], tone: 'sand' -%}
          </div>
          <div class="promo-card__copy">
            {%- if b.kicker != blank -%}<p class="kicker">{{ b.kicker | escape }}</p>{%- endif -%}
            {%- if b.heading != blank -%}<h3 class="promo-card__title">{{ b.heading | escape }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<div class="rte promo-card__text">{{ b.text }}</div>{%- endif -%}
            {%- if b.link_label != blank -%}<a class="link-underline promo-card__link" href="{{ b.link | default: routes.collections_url }}">{{ b.link_label | escape }}</a>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promotional banner",
  "class": "section-promo",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Chosen for you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A little more to love" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Section color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "promo", "name": "Promo card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select", "id": "layout", "label": "Layout",
          "options": [{ "value": "side", "label": "Image beside text" }, { "value": "stack", "label": "Image above text" }, { "value": "overlay", "label": "Text over image" }],
          "default": "side"
        },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Skin reset" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Comforting essentials for sensitive days." },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover skincare" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color_scheme", "id": "color_scheme", "label": "Card color scheme", "default": "scheme-5" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promotional cards",
      "blocks": [
        { "type": "promo" },
        { "type": "promo", "settings": { "kicker": "After dark", "heading": "The evening edit, rich in replenishment.", "link_label": "Explore night care", "color_scheme": "scheme-3" } }
      ]
    },
    {
      "name": "Editorial banner",
      "settings": { "kicker": "", "heading": "" },
      "blocks": [
        { "type": "promo", "settings": { "kicker": "Our ingredient philosophy", "heading": "Formulas that feel like a deep breath.", "text": "<p>Every ritual begins with intelligently chosen botanicals, modern actives, and a focus on skin comfort.</p>", "link_label": "Meet the ingredients", "color_scheme": "scheme-8" } }
      ]
    }
  ]
}
{% endschema %}
