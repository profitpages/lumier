{%- comment -%}
  Promotional cards ("A little more to love") or a single editorial banner (image + colored panel).
{%- endcomment -%}
{{ 'section-promo.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
{%- assign arts = 'jar,serum,compact' | split: ',' -%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading -%}
    <div class="promos" style="--cols: {{ section.blocks.size | at_most: 3 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="promo-card promo-card--{{ b.layout }} color-{{ b.color_scheme }}" data-reveal {{ block.shopify_attributes }}>
          <div class="promo-card__media">
            {%- render 'responsive-image', image: b.image, max: 1200, sizes: '(min-width: 990px) 40vw, 92vw', class: 'promo-card__img', art: arts[forloop.index0], tone: 'sand' -%}
          </div>
          <div class="promo-card__copy">
            {%- if b.kicker != blank -%}<p class="kicker">{{ b.kicker | escape }}</p>{%- endif -%}
            {%- if b.heading != blank -%}<h3 class="promo-card__title">{{ b.heading | escape }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<div class="rte promo-card__text">{{ b.text }}</div>{%- endif -%}
            {%- if b.link_label != blank -%}<a class="link-underline promo-card__link" href="{{ b.link | default: routes.collections_url }}">{{ b.link_label | escape }}</a>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.promo-banner.name",
  "class": "section-promo",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.promo-banner.settings.kicker.label",
      "default": "Chosen for you"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.promo-banner.settings.heading.label",
      "default": "A little more to love"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.promo-banner.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "t:sections.promo-banner.blocks.promo.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.promo-banner.blocks.promo.settings.image.label"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "t:sections.promo-banner.blocks.promo.settings.layout.label",
          "options": [
            {
              "value": "side",
              "label": "t:sections.promo-banner.blocks.promo.settings.layout.options__1.label"
            },
            {
              "value": "stack",
              "label": "t:sections.promo-banner.blocks.promo.settings.layout.options__2.label"
            },
            {
              "value": "overlay",
              "label": "t:sections.promo-banner.blocks.promo.settings.layout.options__3.label"
            }
          ],
          "default": "side"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.promo-banner.blocks.promo.settings.kicker.label",
          "default": "Skin reset"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.promo-banner.blocks.promo.settings.heading.label",
          "default": "Comforting essentials for sensitive days."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.promo-banner.blocks.promo.settings.text.label"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.promo-banner.blocks.promo.settings.link_label.label",
          "default": "Discover skincare"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.promo-banner.blocks.promo.settings.link.label"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.promo-banner.blocks.promo.settings.color_scheme.label",
          "default": "scheme-5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.promo-banner.presets.presets__1.name",
      "blocks": [
        {
          "type": "promo"
        },
        {
          "type": "promo",
          "settings": {
            "kicker": "After dark",
            "heading": "The evening edit, rich in replenishment.",
            "link_label": "Explore night care",
            "color_scheme": "scheme-3"
          }
        }
      ]
    },
    {
      "name": "t:sections.promo-banner.presets.presets__2.name",
      "settings": {
        "kicker": "",
        "heading": ""
      },
      "blocks": [
        {
          "type": "promo",
          "settings": {
            "kicker": "Our ingredient philosophy",
            "heading": "Formulas that feel like a deep breath.",
            "text": "<p>Every ritual begins with intelligently chosen botanicals, modern actives, and a focus on skin comfort.</p>",
            "link_label": "Meet the ingredients",
            "color_scheme": "scheme-8"
          }
        }
      ]
    }
  ]
}
{% endschema %}
