{%- comment -%} Recently viewed — handles saved in the browser on product pages; cards rendered through card-render. {%- endcomment -%}
{%- assign s = section.settings -%}
<recently-viewed class="section color-{{ s.color_scheme }}" data-limit="{{ s.limit }}" data-exclude="{{ product.handle }}" hidden style="--cols: {{ s.limit }}; --cols-m: 2;">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, link_label: s.link_label, link: routes.all_products_collection_url -%}
    <ul class="product-grid" role="list" data-recent-grid></ul>
  </div>
</recently-viewed>

{% schema %}
{
  "name": "t:sections.recently-viewed.name",
  "class": "section-recently-viewed",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.recently-viewed.settings.kicker.label",
      "default": "Continue your ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.recently-viewed.settings.heading.label",
      "default": "Recently viewed"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.recently-viewed.settings.link_label.label",
      "default": "Shop all"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:sections.recently-viewed.settings.limit.label",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.recently-viewed.settings.color_scheme.label",
      "default": "scheme-4"
    }
  ],
  "presets": [
    {
      "name": "t:sections.recently-viewed.presets.presets__1.name"
    }
  ]
}
{% endschema %}
