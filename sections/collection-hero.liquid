{%- comment -%}
  Collection banner — collection title, description, product count and image (with offset slab,
  accent dot and caption chip). Falls back to section settings outside collection pages.
{%- endcomment -%}
{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign title = s.heading
  assign desc = s.text
  assign frame_img = s.image
  if collection
    assign title = collection.title
    if collection.description != blank
      assign desc = collection.description
    endif
    if frame_img == blank
      assign frame_img = collection.image
    endif
  elsif request.page_type == 'search'
    assign title = 'search.title' | t
  endif
-%}
<section class="coll-hero-wrap color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- if s.show_breadcrumb -%}{%- render 'breadcrumb' -%}{%- endif -%}
    <div class="coll-hero{% unless s.show_art %} coll-hero--text{% endunless %}">
      <div class="coll-hero__copy">
        {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        <h1 class="coll-hero__title{% if s.title_size == 'large' %} h1{% endif %}">{{ title | escape }}</h1>
        {%- if desc != blank -%}<div class="rte coll-hero__text">{{ desc }}</div>{%- endif -%}
        {%- if s.show_count and collection -%}<p class="kicker coll-hero__count">{{ 'collections.product_count_essentials' | t: count: collection.products_count }}</p>{%- endif -%}
      </div>
      {%- if s.show_art -%}
        <div class="coll-hero__art">
          <div class="coll-hero__frame frame has-slab-soft">
            {%- render 'responsive-image', image: frame_img, max: 1400, sizes: '(min-width: 990px) 48vw, 92vw', class: 'coll-hero__img', eager: true, art: 'serum', tone: 'linen' -%}
          </div>
          {%- if s.show_dot -%}<span class="dot-accent coll-hero__dot" aria-hidden="true"></span>{%- endif -%}
          {%- if s.caption != blank -%}<span class="caption-chip caption-chip--serif coll-hero__caption">{{ s.caption | escape }}</span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection-hero.name",
  "class": "section-collection-hero",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.collection-hero.settings.kicker.label",
      "default": "Collection 01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collection-hero.settings.heading.label",
      "default": "The Skincare Edit"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.collection-hero.settings.text.label",
      "default": "<p>Thoughtfully formulated essentials for skin that looks and feels beautifully cared for.</p>"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "t:sections.collection-hero.settings.title_size.label",
      "options": [
        {
          "value": "editorial",
          "label": "t:sections.collection-hero.settings.title_size.options__1.label"
        },
        {
          "value": "large",
          "label": "t:sections.collection-hero.settings.title_size.options__2.label"
        }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "show_art",
      "label": "t:sections.collection-hero.settings.show_art.label",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.collection-hero.settings.image.label",
      "info": "t:sections.collection-hero.settings.image.info"
    },
    {
      "type": "checkbox",
      "id": "show_dot",
      "label": "t:sections.collection-hero.settings.show_dot.label",
      "default": true
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:sections.collection-hero.settings.caption.label",
      "default": "A daily ritual, beautifully considered."
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.collection-hero.settings.show_count.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.collection-hero.settings.show_breadcrumb.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.collection-hero.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-hero.presets.presets__1.name"
    }
  ]
}
{% endschema %}
