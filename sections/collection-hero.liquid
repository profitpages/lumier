{%- comment -%}
  Collection banner — collection title, description, product count and image (with offset slab,
  accent dot and caption chip). Falls back to section settings outside collection pages.
{%- endcomment -%}
{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign title = s.heading
  assign desc = s.text
  assign frame_img = s.image
  if collection
    assign title = collection.title
    if collection.description != blank
      assign desc = collection.description
    endif
    if frame_img == blank
      assign frame_img = collection.image
    endif
  elsif request.page_type == 'search'
    assign title = 'search.title' | t
  endif
-%}
<section class="coll-hero-wrap color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- if s.show_breadcrumb -%}{%- render 'breadcrumb' -%}{%- endif -%}
    <div class="coll-hero{% unless s.show_art %} coll-hero--text{% endunless %}">
      <div class="coll-hero__copy">
        {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        <h1 class="coll-hero__title{% if s.title_size == 'large' %} h1{% endif %}">{{ title | escape }}</h1>
        {%- if desc != blank -%}<div class="rte coll-hero__text">{{ desc }}</div>{%- endif -%}
        {%- if s.show_count and collection -%}<p class="kicker coll-hero__count">{{ 'collections.product_count_essentials' | t: count: collection.products_count }}</p>{%- endif -%}
      </div>
      {%- if s.show_art -%}
        <div class="coll-hero__art">
          <div class="coll-hero__frame frame has-slab-soft">
            {%- render 'responsive-image', image: frame_img, max: 1400, sizes: '(min-width: 990px) 48vw, 92vw', class: 'coll-hero__img', eager: true, art: 'serum', tone: 'linen' -%}
          </div>
          {%- if s.show_dot -%}<span class="dot-accent coll-hero__dot" aria-hidden="true"></span>{%- endif -%}
          {%- if s.caption != blank -%}<span class="caption-chip caption-chip--serif coll-hero__caption">{{ s.caption | escape }}</span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection banner",
  "class": "section-collection-hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Collection 01" },
    { "type": "text", "id": "heading", "label": "Heading (when not on a collection)", "default": "The Skincare Edit" },
    { "type": "richtext", "id": "text", "label": "Text (when the collection has no description)", "default": "<p>Thoughtfully formulated essentials for skin that looks and feels beautifully cared for.</p>" },
    {
      "type": "select", "id": "title_size", "label": "Title size",
      "options": [{ "value": "editorial", "label": "Editorial (small serif)" }, { "value": "large", "label": "Large" }],
      "default": "large"
    },
    { "type": "checkbox", "id": "show_art", "label": "Show framed image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image." },
    { "type": "checkbox", "id": "show_dot", "label": "Accent dot", "default": true },
    { "type": "text", "id": "caption", "label": "Caption chip", "default": "A daily ritual, beautifully considered." },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Collection banner" }]
}
{% endschema %}
