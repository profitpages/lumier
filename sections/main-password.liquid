<section class="password color-{{ section.settings.color_scheme }}">
  {%- render 'decor', preset: 'hero' -%}
  <div class="password__card panel-card">
    {%- render 'wordmark' -%}
    <div class="password__art">{%- render 'cosmetic-art', name: 'serum', tone: 'blush' -%}</div>
    <p class="kicker">{{ section.settings.kicker | escape }}</p>
    <h1 class="h2">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'nl-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-msg form-msg--ok" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="nl-form__field">
          <label class="visually-hidden" for="PwNewsletter">{{ 'newsletter.email_label' | t }}</label>
          <input class="input" id="PwNewsletter" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.email_label' | t }}">
          <button class="btn btn--solid" type="submit">{{ 'password.notify' | t }}</button>
        </div>
        {%- if form.errors -%}<div class="form-msg form-msg--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
    <details class="acc acc--compact">
      <summary class="acc__q">{{ 'password.owner' | t }}<span class="acc__plus" aria-hidden="true"></span></summary>
      <div class="acc__a"><div class="acc__inner">
        {%- form 'storefront_password', class: 'form-grid' -%}
          {%- if form.errors -%}<div class="form-msg form-msg--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="field"><label class="label" for="StorePassword">{{ 'customer.password' | t }}</label><input class="input" id="StorePassword" type="password" name="password" autocomplete="current-password" required></div>
          <button class="btn btn--solid" type="submit">{{ 'password.enter' | t }}</button>
        {%- endform -%}
      </div></div>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Opening soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something luminous is on its way." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
