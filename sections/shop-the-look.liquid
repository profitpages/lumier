{%- comment -%}
  Shop the look — editorial image with product hotspots and a matching product list.
  Hotspot positions are set per block (percent from left / top).
{%- endcomment -%}
{{ 'section-lumiere-more.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign arts = 'serum,jar,tube,pump,compact,lipstick' | split: ','
-%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    <look-book class="look{% if s.image_right %} look--image-right{% endif %}">
      <div class="look__media">
        <div class="look__frame frame frame--{{ s.frame }}{% if s.frame == 'arch' %} has-slab{% else %} has-shadow{% endif %}">
          {%- render 'responsive-image', image: s.image, max: 1600, sizes: '(min-width: 990px) 50vw, 92vw', class: 'look__img', art: 'portrait', tone: 'blush' -%}
        </div>
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- liquid
            assign edge = ''
            if block.settings.x < 30
              assign edge = ' look__spot--start'
            elsif block.settings.x > 70
              assign edge = ' look__spot--end'
            endif
          -%}
          <div class="look__spot{{ edge }}" style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;" {{ block.shopify_attributes }}>
            <button class="look__dot" type="button" data-look-dot="{{ forloop.index0 }}" aria-expanded="false" aria-controls="Look-{{ section.id }}-{{ forloop.index0 }}">
              <span class="visually-hidden">{%- if p != blank -%}{{ p.title | escape }}{%- else -%}{{ 'products.placeholder_title' | t }}{%- endif -%}</span>
            </button>
            <div class="look__pop" id="Look-{{ section.id }}-{{ forloop.index0 }}" hidden>
              {%- if p != blank -%}
                <a class="look__pop-link" href="{{ p.url }}">
                  <span class="look__pop-title">{{ p.title | escape }}</span>
                  {%- render 'price', product: p -%}
                </a>
              {%- else -%}
                <span class="look__pop-title">{{ 'products.placeholder_title' | t }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="look__copy">
        {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte look__text">{{ s.text }}</div>{%- endif -%}
        <ol class="look__list" role="list">
          {%- for block in section.blocks -%}
            {%- assign p = block.settings.product -%}
            {%- assign i = forloop.index0 | modulo: 6 -%}
            <li class="look__item" data-look-item="{{ forloop.index0 }}">
              <span class="look__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="look__thumb">
                {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 64, height: 64 }}{%- else -%}{%- render 'cosmetic-art', name: arts[i] -%}{%- endif -%}
              </span>
              <span class="look__meta">
                {%- if p != blank -%}
                  <a class="look__title" href="{{ p.url }}">{{ p.title | escape }}</a>
                  {%- render 'price', product: p -%}
                {%- else -%}
                  <span class="look__title">{{ 'products.placeholder_title' | t }}</span>
                {%- endif -%}
              </span>
              {%- if p != blank and p.available -%}
                {%- if p.has_only_default_variant -%}
                  {%- assign look_form = 'look-' | append: section.id | append: '-' | append: forloop.index -%}
                  {%- form 'product', p, id: look_form, data-product-form: '', novalidate: 'novalidate' -%}
                    <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                    <button class="link-underline" type="submit" name="add">{{ 'products.quick_add' | t }}</button>
                  {%- endform -%}
                {%- else -%}
                  <button class="link-underline" type="button" data-quick-add="{{ p.url }}" aria-haspopup="dialog">{{ 'products.quick_add' | t }}</button>
                {%- endif -%}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
        {%- render 'button', label: s.button_label, url: s.button_link, style: 'outline' -%}
      </div>
    </look-book>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.shop-the-look.name",
  "class": "section-shop-the-look",
  "max_blocks": 6,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.shop-the-look.settings.image.label"
    },
    {
      "type": "select",
      "id": "frame",
      "label": "t:sections.shop-the-look.settings.frame.label",
      "options": [
        {
          "value": "soft",
          "label": "t:sections.shop-the-look.settings.frame.options__1.label"
        },
        {
          "value": "corner",
          "label": "t:sections.shop-the-look.settings.frame.options__2.label"
        },
        {
          "value": "arch",
          "label": "t:sections.shop-the-look.settings.frame.options__3.label"
        }
      ],
      "default": "corner"
    },
    {
      "type": "checkbox",
      "id": "image_right",
      "label": "t:sections.shop-the-look.settings.image_right.label",
      "default": false
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.shop-the-look.settings.kicker.label",
      "default": "Shop the look"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.shop-the-look.settings.heading.label",
      "default": "The morning glow, decoded."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.shop-the-look.settings.text.label",
      "default": "<p>Tap a point on the image to see what's in the ritual.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.shop-the-look.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.shop-the-look.settings.button_link.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shop-the-look.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "t:sections.shop-the-look.blocks.hotspot.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.shop-the-look.blocks.hotspot.settings.product.label"
        },
        {
          "type": "range",
          "id": "x",
          "label": "t:sections.shop-the-look.blocks.hotspot.settings.x.label",
          "min": 2,
          "max": 98,
          "step": 1,
          "unit": "%",
          "default": 40
        },
        {
          "type": "range",
          "id": "y",
          "label": "t:sections.shop-the-look.blocks.hotspot.settings.y.label",
          "min": 2,
          "max": 98,
          "step": 1,
          "unit": "%",
          "default": 40
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.shop-the-look.presets.presets__1.name",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "x": 34,
            "y": 38
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "x": 62,
            "y": 56
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "x": 46,
            "y": 76
          }
        }
      ]
    }
  ]
}
{% endschema %}
