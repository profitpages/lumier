{%- comment -%}
  Before / after — a native range input drives the reveal (keyboard, touch and screen-reader friendly).
  Layouts: reveal (curved-corner frame with a range chip) | split (soft panel, divider + labels underneath)
{%- endcomment -%}
{{ 'section-lumiere.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign ba_id = 'BA-' | append: section.id
  assign range_label = s.range_label
  if range_label == blank
    assign range_label = 'sections.compare_label' | t
  endif
-%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width ba-grid ba-grid--{{ s.layout }}">
    <div class="ba-copy">
      {%- if s.kicker != blank -%}<p class="kicker{% if s.layout == 'split' %} kicker--accent{% endif %}">{{ s.kicker | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte ba-copy__text">{{ s.text }}</div>{%- endif -%}
      {%- if s.note != blank and s.layout == 'reveal' -%}<p class="ba-note">{{ s.note | escape }}</p>{%- endif -%}
      {%- render 'button', label: s.button_label, url: s.button_link, style: 'outline' -%}
    </div>
    <div class="ba-wrap">
      <before-after class="ba ba--{{ s.layout }}" style="--pos: {{ s.start }}%;">
        <div class="ba__frame{% if s.layout == 'reveal' %} frame--corner{% endif %}">
          <div class="ba__img ba__img--after">
            {%- render 'responsive-image', image: s.after, max: 1400, sizes: '(min-width: 990px) 46vw, 92vw', art: 'portrait', tone: 'blush' -%}
          </div>
          <div class="ba__img ba__img--before" aria-hidden="true">
            {%- render 'responsive-image', image: s.before, max: 1400, sizes: '(min-width: 990px) 46vw, 92vw', art: 'portrait', tone: 'linen' -%}
          </div>
          <span class="ba__line" aria-hidden="true"></span>
          <label class="{% if s.layout == 'reveal' %}ba__chip{% else %}visually-hidden{% endif %}" for="{{ ba_id }}">
            <span>{{ range_label | escape }}</span>
            {%- if s.layout == 'reveal' -%}<input class="ba__range ba__range--chip" id="{{ ba_id }}" type="range" min="0" max="100" value="{{ s.start }}" data-ba-range>{%- endif -%}
          </label>
          {%- if s.layout == 'split' -%}
            <input class="ba__range ba__range--bar" id="{{ ba_id }}" type="range" min="0" max="100" value="{{ s.start }}" data-ba-range>
          {%- endif -%}
        </div>
      </before-after>
      {%- if s.layout == 'split' -%}
        <div class="ba__labels"><span>{{ s.before_label | escape }}</span><span>{{ s.after_label | escape }}</span></div>
        {%- if s.note != blank -%}<p class="ba-note">{{ s.note | escape }}</p>{%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.before-after.name",
  "class": "section-before-after",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.before-after.settings.layout.label",
      "options": [
        {
          "value": "reveal",
          "label": "t:sections.before-after.settings.layout.options__1.label"
        },
        {
          "value": "split",
          "label": "t:sections.before-after.settings.layout.options__2.label"
        }
      ],
      "default": "reveal"
    },
    {
      "type": "image_picker",
      "id": "before",
      "label": "t:sections.before-after.settings.before.label"
    },
    {
      "type": "image_picker",
      "id": "after",
      "label": "t:sections.before-after.settings.after.label",
      "info": "t:sections.before-after.settings.after.info"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "t:sections.before-after.settings.before_label.label",
      "default": "Bare skin"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "t:sections.before-after.settings.after_label.label",
      "default": "After the ritual"
    },
    {
      "type": "text",
      "id": "range_label",
      "label": "t:sections.before-after.settings.range_label.label",
      "default": "Reveal image"
    },
    {
      "type": "range",
      "id": "start",
      "label": "t:sections.before-after.settings.start.label",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.before-after.settings.kicker.label",
      "default": "A closer look"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.before-after.settings.heading.label",
      "default": "Skin, in soft focus"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.before-after.settings.text.label",
      "default": "<p>An illustrative view of a well-loved routine. Individual experiences vary.</p>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "t:sections.before-after.settings.note.label",
      "default": "A simple ritual. A more comfortable, radiant-looking finish."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.before-after.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.before-after.settings.button_link.label"
    },
    {
      "type": "paragraph",
      "content": "t:sections.before-after.settings.paragraph__14.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.before-after.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.before-after.presets.presets__1.name"
    },
    {
      "name": "t:sections.before-after.presets.presets__2.name",
      "settings": {
        "layout": "split",
        "start": 50,
        "kicker": "The veil effect",
        "heading": "Skin, softly illuminated.",
        "text": "<p>Move the handle to explore the appearance of hydrated, light-reflective skin after a consistent ritual.</p>",
        "note": "Individual results may vary.",
        "range_label": "Compare before and after"
      }
    }
  ]
}
{% endschema %}
