{%- comment -%}
  Complete your routine — connected product steps (Cleanse → Treat → Moisturize → Protect)
  with an "Add the routine" button that adds every in-stock step to the bag in one request.
{%- endcomment -%}
{{ 'section-routine.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign ids = ''
-%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, side: true -%}
    <routine-bundle class="routine">
      <ol class="routine__steps" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign p = block.settings.product
            if block.settings.use_current and product
              assign p = product
            endif
            if p != blank and p.available
              assign v = p.selected_or_first_available_variant
              assign ids = ids | append: v.id | append: ','
            endif
          -%}
          <li class="routine__step" data-reveal {{ block.shopify_attributes }}>
            <span class="routine__label">{{ forloop.index | prepend: '0' | slice: -2, 2 }} · {{ block.settings.label | escape }}</span>
            <a class="routine__card" href="{{ p.url | default: '#' }}"{% if p == blank %} aria-disabled="true" tabindex="-1"{% endif %}>
              <span class="routine__media">
                {%- render 'responsive-image', image: p.featured_media.preview_image, max: 600, sizes: '(min-width: 990px) 20vw, 60vw', art: 'pump', tone: 'blush' -%}
              </span>
              <span class="routine__name">{%- if p != blank -%}{{ p.title | escape }}{%- else -%}{{ 'products.placeholder_title' | t }}{%- endif -%}</span>
              {%- if p != blank -%}{%- render 'price', product: p -%}{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ol>
      <div class="routine__bundle color-{{ s.bundle_scheme }}">
        {%- render 'decor', preset: 'corner' -%}
        {%- if s.bundle_kicker != blank -%}<p class="kicker">{{ s.bundle_kicker | escape }}</p>{%- endif -%}
        <h3 class="routine__bundle-title">{{ s.bundle_title | escape }}</h3>
        {%- if s.bundle_text != blank -%}<div class="rte routine__bundle-text">{{ s.bundle_text }}</div>{%- endif -%}
        <button class="btn btn--solid" type="button" data-routine-add="{{ ids | remove_last: ',' }}"{% if ids == blank %} disabled{% endif %}>
          {%- render 'icon', name: 'bag', size: 18 -%}<span>{{ s.button_label | escape }}</span>
        </button>
        <p class="form-msg form-msg--error" role="alert" hidden data-routine-error></p>
      </div>
    </routine-bundle>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.routine.name",
  "class": "section-routine",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.routine.settings.kicker.label",
      "default": "Build your ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.routine.settings.heading.label",
      "default": "A three-step glow story."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.routine.settings.text.label",
      "default": "<p>Thoughtful layers that let your skin look calm, plush and perfectly awake.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.routine.settings.header__4.content"
    },
    {
      "type": "text",
      "id": "bundle_kicker",
      "label": "t:sections.routine.settings.bundle_kicker.label",
      "default": "The full ritual"
    },
    {
      "type": "text",
      "id": "bundle_title",
      "label": "t:sections.routine.settings.bundle_title.label",
      "default": "Take the whole routine home."
    },
    {
      "type": "richtext",
      "id": "bundle_text",
      "label": "t:sections.routine.settings.bundle_text.label",
      "info": "t:sections.routine.settings.bundle_text.info"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.routine.settings.button_label.label",
      "default": "Add the routine"
    },
    {
      "type": "color_scheme",
      "id": "bundle_scheme",
      "label": "t:sections.routine.settings.bundle_scheme.label",
      "default": "scheme-6"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.routine.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.routine.blocks.step.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.routine.blocks.step.settings.label.label",
          "default": "Cleanse"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.routine.blocks.step.settings.product.label"
        },
        {
          "type": "checkbox",
          "id": "use_current",
          "label": "t:sections.routine.blocks.step.settings.use_current.label",
          "default": false,
          "info": "t:sections.routine.blocks.step.settings.use_current.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.routine.presets.presets__1.name",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "label": "Cleanse"
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "Treat",
            "use_current": true
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "Moisturize"
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "Protect"
          }
        }
      ]
    }
  ]
}
{% endschema %}
