{%- liquid
  assign s = section.settings
  assign menu = s.menu
  assign has_menu = false
  if menu != blank and menu.links.size > 0
    assign has_menu = true
  endif
-%}
<site-header class="header color-{{ s.color_scheme }}{% if s.sticky %} header--sticky{% endif %} header--logo-{{ s.logo_position }}" data-header>
  <div class="header__inner page-width">
    <button class="icon-btn header__burger" type="button" aria-expanded="false" aria-controls="MenuSheet" data-menu-open aria-label="{{ 'general.menu' | t }}">
      {%- render 'icon', name: 'menu', size: 24 -%}
    </button>

    <div class="header__logo">
      {%- render 'wordmark' -%}
    </div>

    <nav class="header__nav" aria-label="{{ 'general.primary_navigation' | t }}">
      <ul class="nav nav--{{ s.nav_style }}" role="list">
        {%- if has_menu -%}
          {%- for link in menu.links -%}
            {%- liquid
              assign promo = nil
              for block in section.blocks
                assign target = block.settings.menu_item | downcase | strip
                assign title_down = link.title | downcase | strip
                if target == title_down
                  assign promo = block
                endif
              endfor
              assign is_mega = false
              for child in link.links
                if child.links.size > 0
                  assign is_mega = true
                endif
              endfor
              if promo
                assign is_mega = true
              endif
            -%}
            <li class="nav__item">
              {%- if link.links.size > 0 -%}
                <details class="nav__dd{% if is_mega %} nav__dd--mega{% endif %}" data-dropdown>
                  <summary class="nav__link{% if link.child_active %} is-active{% endif %}">
                    {{ link.title | escape }}{%- render 'icon', name: 'chevron-down', size: 14 -%}
                  </summary>
                  <div class="nav__panel color-{{ s.menu_scheme }}">
                    <div class="nav__panel-inner{% if is_mega %} page-width{% endif %}">
                      <ul class="nav__cols" role="list">
                        {%- for child in link.links -%}
                          <li class="nav__col">
                            <a class="nav__child{% if child.links.size > 0 %} nav__child--head{% endif %}" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                            {%- if child.links.size > 0 -%}
                              <ul class="nav__grand" role="list">
                                {%- for grand in child.links -%}
                                  <li><a href="{{ grand.url }}"{% if grand.current %} aria-current="page"{% endif %}>{{ grand.title | escape }}</a></li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                      {%- if promo -%}
                        <a class="nav__promo" href="{{ promo.settings.link | default: link.url }}" {{ promo.shopify_attributes }}>
                          <span class="nav__promo-media">
                            {%- render 'responsive-image', image: promo.settings.image, max: 600, sizes: '280px', art: 'serum', tone: 'blush' -%}
                          </span>
                          {%- if promo.settings.kicker != blank -%}<span class="kicker">{{ promo.settings.kicker | escape }}</span>{%- endif -%}
                          <span class="nav__promo-title">{{ promo.settings.heading | escape }}</span>
                        </a>
                      {%- endif -%}
                    </div>
                  </div>
                </details>
              {%- else -%}
                <a class="nav__link{% if link.active %} is-active{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="nav__item"><a class="nav__link" href="{{ routes.all_products_collection_url }}">{{ 'general.shop_all' | t }}</a></li>
          <li class="nav__item"><a class="nav__link" href="{{ routes.collections_url }}">{{ 'collections.all_collections' | t }}</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <div class="header__icons">
      {%- if s.show_search -%}
        <a class="icon-btn" href="{{ routes.search_url }}" data-search-open aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search', size: 21 %}</a>
      {%- endif -%}
      {%- if s.show_account and shop.customer_accounts_enabled -%}
        <a class="icon-btn header__account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'user', size: 21 %}</a>
      {%- endif -%}
      {%- if settings.wishlist_enable and s.show_wishlist -%}
        <a class="icon-btn header__wish" href="{% if settings.wishlist_page != blank %}{{ settings.wishlist_page.url }}{% else %}{{ routes.root_url }}{% endif %}" aria-label="{{ 'general.wishlist' | t }}">
          {%- render 'icon', name: 'heart', size: 21 -%}<span class="count-badge" data-wishlist-count hidden>0</span>
        </a>
      {%- endif -%}
      <a class="header__cart{% if s.cart_style == 'pill' %} header__cart--pill{% else %} icon-btn{% endif %}" href="{{ routes.cart_url }}" id="cart-icon-bubble" data-cart-open aria-label="{{ 'general.cart' | t }}">
        {%- render 'icon', name: 'bag', size: 20 -%}
        {%- if s.cart_style == 'pill' -%}<span class="header__cart-label" aria-hidden="true">{{ 'general.cart' | t }}</span>{%- endif -%}
        <span data-cart-bubble>{%- render 'cart-bubble' -%}</span>
      </a>
    </div>
  </div>

  {%- comment -%} Mobile menu sheet {%- endcomment -%}
  <dialog id="MenuSheet" class="sheet color-{{ s.menu_scheme }}" aria-label="{{ 'general.menu' | t }}" data-menu-sheet>
    <div class="sheet__head">
      {%- render 'wordmark' -%}
      <button class="icon-btn" type="button" data-menu-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close', size: 24 %}</button>
    </div>
    <nav class="sheet__nav" aria-label="{{ 'general.mobile_navigation' | t }}">
      <ul role="list">
        {%- if has_menu -%}
          {%- for link in menu.links -%}
            <li class="sheet__item" style="--i: {{ forloop.index }};">
              {%- if link.links.size > 0 -%}
                <details class="sheet__dd">
                  <summary class="sheet__link">{{ link.title | escape }}{% render 'icon', name: 'plus', size: 20 %}</summary>
                  <ul class="sheet__sub" role="list">
                    <li><a href="{{ link.url }}">{{ 'general.view_all_of' | t: title: link.title }}</a></li>
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                      {%- for grand in child.links -%}<li class="sheet__grand"><a href="{{ grand.url }}">{{ grand.title | escape }}</a></li>{%- endfor -%}
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a class="sheet__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="sheet__item"><a class="sheet__link" href="{{ routes.all_products_collection_url }}">{{ 'general.shop_all' | t }}</a></li>
          <li class="sheet__item"><a class="sheet__link" href="{{ routes.collections_url }}">{{ 'collections.all_collections' | t }}</a></li>
        {%- endif -%}
      </ul>
    </nav>
    <div class="sheet__foot">
      {%- if shop.customer_accounts_enabled -%}
        <a class="sheet__util" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">{% render 'icon', name: 'user', size: 18 %} {% if customer %}{{ 'customer.account' | t }}{% else %}{{ 'customer.log_in' | t }}{% endif %}</a>
      {%- endif -%}
      <a class="sheet__util" href="{{ routes.search_url }}" data-search-open>{% render 'icon', name: 'search', size: 18 %} {{ 'general.search' | t }}</a>
      {%- if s.sheet_note != blank -%}<p class="sheet__note">{{ s.sheet_note | escape }}</p>{%- endif -%}
    </div>
  </dialog>
</site-header>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {%- if settings.logo -%}"logo": {{ settings.logo | image_url: width: 500 | prepend: 'https:' | json }},{%- endif -%}
    "url": {{ shop.url | json }}
  }
</script>
{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ shop.url }}{{ routes.search_url }}?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "max_blocks": 6,
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    {
      "type": "select", "id": "logo_position", "label": "Logo position (desktop)",
      "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }],
      "default": "left"
    },
    {
      "type": "select", "id": "nav_style", "label": "Menu style",
      "options": [{ "value": "plain", "label": "Sentence case" }, { "value": "caps", "label": "Small caps, letter-spaced" }],
      "default": "plain"
    },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    {
      "type": "select", "id": "cart_style", "label": "Cart button",
      "options": [{ "value": "icon", "label": "Icon" }, { "value": "pill", "label": "Pill with label" }],
      "default": "icon"
    },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "menu_scheme", "label": "Dropdown & mobile menu scheme", "default": "scheme-2" },
    { "type": "text", "id": "sheet_note", "label": "Mobile menu note", "default": "Complimentary shipping on orders over $75." }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Mega menu promo",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Show in menu item", "info": "Type the top-level menu title exactly, e.g. 'Shop'.", "default": "Shop" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "New ritual" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Glow Veil Serum" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
