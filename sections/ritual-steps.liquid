{%- comment -%} Ritual / How to use — numbered steps (numbers follow block order). {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section color-{{ s.section_scheme }}">
  <div class="page-width">
    <div class="{% if s.panel %}panel color-{{ s.color_scheme }}{% endif %} steps-wrap">
      {%- if s.panel -%}{%- render 'decor', preset: 'corner' -%}{%- endif -%}
      <div class="steps-head">{%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text -%}</div>
      {%- if s.use_metafield and product and product.metafields.custom.how_to_use != blank -%}
        <div class="steps__full rte">{{ product.metafields.custom.how_to_use | metafield_tag }}</div>
      {%- endif -%}
      <ol class="steps" role="list" style="--cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }};">
        {%- for block in section.blocks -%}
          <li class="step" data-reveal {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="step__media">{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 990px) 22vw, 80vw', alt: '' }}</div>
            {%- endif -%}
            <span class="step__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="step__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p class="step__text">{{ block.settings.text | escape }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
      {%- if s.button_label != blank -%}
        <div class="btn-row steps__cta">{%- render 'button', label: s.button_label, url: s.button_link, style: 'solid' -%}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ritual steps",
  "class": "section-steps",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "How to use" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three quiet minutes for a more luminous ritual." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "use_metafield", "label": "On product pages, also show the product's how-to-use text", "default": false, "info": "Reads custom.how_to_use." },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "panel", "label": "Show inside a panel", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Panel color scheme", "default": "scheme-2" },
    { "type": "color_scheme", "id": "section_scheme", "label": "Section color scheme", "default": "scheme-6" }
  ],
  "blocks": [
    {
      "type": "step", "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Prepare" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "After cleansing, press 2–3 drops between palms while skin is still softly damp." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How to use",
      "blocks": [
        { "type": "step", "settings": { "title": "Prepare", "text": "After cleansing, press 2–3 drops between palms while skin is still softly damp." } },
        { "type": "step", "settings": { "title": "Press", "text": "Press from the centre of the face outward, letting the formula melt in without rush." } },
        { "type": "step", "settings": { "title": "Seal", "text": "Follow with moisturiser and SPF in the morning, or a richer cream in the evening." } }
      ]
    },
    {
      "name": "Routine steps",
      "settings": { "kicker": "Your ritual", "heading": "Cleanse, treat, moisturise, protect.", "section_scheme": "scheme-1" },
      "blocks": [
        { "type": "step", "settings": { "title": "Cleanse", "text": "Begin with a fresh, comfortable canvas." } },
        { "type": "step", "settings": { "title": "Treat", "text": "Add a targeted serum to your ritual." } },
        { "type": "step", "settings": { "title": "Moisturise", "text": "Seal in softness with a comforting cream." } },
        { "type": "step", "settings": { "title": "Protect", "text": "Finish with broad-spectrum SPF in the morning." } }
      ]
    }
  ]
}
{% endschema %}
