{%- comment -%} Ritual / How to use — numbered steps (numbers follow block order). {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section color-{{ s.section_scheme }}">
  <div class="page-width">
    <div class="{% if s.panel %}panel color-{{ s.color_scheme }}{% endif %} steps-wrap">
      {%- if s.panel -%}{%- render 'decor', preset: 'corner' -%}{%- endif -%}
      <div class="steps-head">{%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text -%}</div>
      {%- if s.use_metafield and product and product.metafields.custom.how_to_use != blank -%}
        <div class="steps__full rte">{{ product.metafields.custom.how_to_use | metafield_tag }}</div>
      {%- endif -%}
      <ol class="steps" role="list" style="--cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }};">
        {%- for block in section.blocks -%}
          <li class="step" data-reveal {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="step__media">{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 990px) 22vw, 80vw', alt: '' }}</div>
            {%- endif -%}
            <span class="step__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="step__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p class="step__text">{{ block.settings.text | escape }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
      {%- if s.button_label != blank -%}
        <div class="btn-row steps__cta">{%- render 'button', label: s.button_label, url: s.button_link, style: 'solid' -%}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.ritual-steps.name",
  "class": "section-steps",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.ritual-steps.settings.kicker.label",
      "default": "How to use"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.ritual-steps.settings.heading.label",
      "default": "Three quiet minutes for a more luminous ritual."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.ritual-steps.settings.text.label"
    },
    {
      "type": "checkbox",
      "id": "use_metafield",
      "label": "t:sections.ritual-steps.settings.use_metafield.label",
      "default": false,
      "info": "t:sections.ritual-steps.settings.use_metafield.info"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.ritual-steps.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.ritual-steps.settings.button_link.label"
    },
    {
      "type": "checkbox",
      "id": "panel",
      "label": "t:sections.ritual-steps.settings.panel.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.ritual-steps.settings.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "color_scheme",
      "id": "section_scheme",
      "label": "t:sections.ritual-steps.settings.section_scheme.label",
      "default": "scheme-6"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.ritual-steps.blocks.step.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.ritual-steps.blocks.step.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.ritual-steps.blocks.step.settings.title.label",
          "default": "Prepare"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.ritual-steps.blocks.step.settings.text.label",
          "default": "After cleansing, press 2–3 drops between palms while skin is still softly damp."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.ritual-steps.presets.presets__1.name",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Prepare",
            "text": "After cleansing, press 2–3 drops between palms while skin is still softly damp."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Press",
            "text": "Press from the centre of the face outward, letting the formula melt in without rush."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Seal",
            "text": "Follow with moisturiser and SPF in the morning, or a richer cream in the evening."
          }
        }
      ]
    },
    {
      "name": "t:sections.ritual-steps.presets.presets__2.name",
      "settings": {
        "kicker": "Your ritual",
        "heading": "Cleanse, treat, moisturise, protect.",
        "section_scheme": "scheme-1"
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Cleanse",
            "text": "Begin with a fresh, comfortable canvas."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Treat",
            "text": "Add a targeted serum to your ritual."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Moisturise",
            "text": "Seal in softness with a comforting cream."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Protect",
            "text": "Finish with broad-spectrum SPF in the morning."
          }
        }
      ]
    }
  ]
}
{% endschema %}
