{%- comment -%} Used by customers/activate_account and customers/reset_password. {%- endcomment -%}
<section class="section section--tight auth color-scheme-1">
  {%- render 'decor', preset: 'hero' -%}
  <div class="page-width auth__wrap">
    <div class="panel-card auth__card">
      {%- if request.page_type == 'customers/activate_account' -%}
        <h1 class="h2">{{ 'customer.activate_title' | t }}</h1>
        <p class="auth__lead">{{ 'customer.activate_text' | t }}</p>
        {%- form 'activate_customer_password', class: 'form-grid' -%}
          {%- if form.errors -%}<div class="form-msg form-msg--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="field"><label class="label" for="ActPass">{{ 'customer.password' | t }}</label><input class="input" id="ActPass" type="password" name="customer[password]" autocomplete="new-password" required></div>
          <div class="field"><label class="label" for="ActPass2">{{ 'customer.password_confirm' | t }}</label><input class="input" id="ActPass2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
          <button class="btn btn--solid btn--block" type="submit">{{ 'customer.activate' | t }}</button>
          <button class="btn btn--outline btn--block" type="submit" name="decline">{{ 'customer.decline' | t }}</button>
        {%- endform -%}
      {%- else -%}
        <h1 class="h2">{{ 'customer.reset_title' | t }}</h1>
        {%- form 'reset_customer_password', class: 'form-grid' -%}
          {%- if form.errors -%}<div class="form-msg form-msg--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="field"><label class="label" for="ResetPass">{{ 'customer.password' | t }}</label><input class="input" id="ResetPass" type="password" name="customer[password]" autocomplete="new-password" required></div>
          <div class="field"><label class="label" for="ResetPass2">{{ 'customer.password_confirm' | t }}</label><input class="input" id="ResetPass2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
          <button class="btn btn--solid btn--block" type="submit">{{ 'customer.reset_submit' | t }}</button>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-reset-password.name"
}
{% endschema %}
