{%- comment -%} Countdown banner — end time in the store's timezone; hides (or shows a message) when it ends. {%- endcomment -%}
{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign tz = 'now' | date: '%z'
  assign end_iso = s.end_date | append: 'T' | append: s.end_time | append: ':00'
-%}
<countdown-timer class="section color-{{ s.section_scheme }}" data-end="{{ end_iso }}" data-tz="{{ tz }}" data-expired="{{ s.when_expired }}">
  <div class="page-width">
    <div class="cd panel color-{{ s.color_scheme }}">
      {%- render 'decor', preset: 'band' -%}
      <div class="cd__copy">
        {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte cd__text">{{ s.text }}</div>{%- endif -%}
        {%- render 'button', label: s.button_label, url: s.button_link, style: 'solid' -%}
      </div>
      <div class="cd__clock" role="timer" aria-live="off" data-clock>
        {%- assign units = 'days,hours,minutes,seconds' | split: ',' -%}
        {%- for u in units -%}
          <div class="cd__unit glass-soft">
            <span class="cd__num" data-unit="{{ u }}">00</span>
            <span class="cd__label">
              {%- case u -%}
                {%- when 'days' -%}{{ 'sections.countdown_days' | t }}
                {%- when 'hours' -%}{{ 'sections.countdown_hours' | t }}
                {%- when 'minutes' -%}{{ 'sections.countdown_minutes' | t }}
                {%- else -%}{{ 'sections.countdown_seconds' | t }}
              {%- endcase -%}
            </span>
          </div>
        {%- endfor -%}
      </div>
      <p class="cd__expired" data-expired-msg hidden>{{ s.expired_text | escape }}</p>
    </div>
  </div>
</countdown-timer>

{% schema %}
{
  "name": "Countdown banner",
  "class": "section-countdown",
  "settings": [
    { "type": "text", "id": "end_date", "label": "End date", "default": "2026-12-24", "info": "YYYY-MM-DD" },
    { "type": "text", "id": "end_time", "label": "End time", "default": "23:59", "info": "24-hour HH:MM, store timezone" },
    {
      "type": "select", "id": "when_expired", "label": "When the timer ends",
      "options": [{ "value": "hide", "label": "Hide the section" }, { "value": "message", "label": "Show a message" }],
      "default": "hide"
    },
    { "type": "text", "id": "expired_text", "label": "Ended message", "default": "This edit has ended — new rituals are on the way." },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The holiday edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gift sets, beautifully wrapped — for a little while." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Limited-edition rituals with complimentary gift wrap.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop gift sets" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Panel color scheme", "default": "scheme-7" },
    { "type": "color_scheme", "id": "section_scheme", "label": "Section color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Countdown banner" }]
}
{% endschema %}
