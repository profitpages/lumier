{%- comment -%} Countdown banner — end time in the store's timezone; hides (or shows a message) when it ends. {%- endcomment -%}
{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign tz = 'now' | date: '%z'
  assign end_iso = s.end_date | append: 'T' | append: s.end_time | append: ':00'
-%}
<countdown-timer class="section color-{{ s.section_scheme }}" data-end="{{ end_iso }}" data-tz="{{ tz }}" data-expired="{{ s.when_expired }}">
  <div class="page-width">
    <div class="cd panel color-{{ s.color_scheme }}">
      {%- render 'decor', preset: 'band' -%}
      <div class="cd__copy">
        {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte cd__text">{{ s.text }}</div>{%- endif -%}
        {%- render 'button', label: s.button_label, url: s.button_link, style: 'solid' -%}
      </div>
      <div class="cd__clock" role="timer" aria-live="off" data-clock>
        {%- assign units = 'days,hours,minutes,seconds' | split: ',' -%}
        {%- for u in units -%}
          <div class="cd__unit glass-soft">
            <span class="cd__num" data-unit="{{ u }}">00</span>
            <span class="cd__label">
              {%- case u -%}
                {%- when 'days' -%}{{ 'sections.countdown_days' | t }}
                {%- when 'hours' -%}{{ 'sections.countdown_hours' | t }}
                {%- when 'minutes' -%}{{ 'sections.countdown_minutes' | t }}
                {%- else -%}{{ 'sections.countdown_seconds' | t }}
              {%- endcase -%}
            </span>
          </div>
        {%- endfor -%}
      </div>
      <p class="cd__expired" data-expired-msg hidden>{{ s.expired_text | escape }}</p>
    </div>
  </div>
</countdown-timer>

{% schema %}
{
  "name": "t:sections.countdown.name",
  "class": "section-countdown",
  "settings": [
    {
      "type": "text",
      "id": "end_date",
      "label": "t:sections.countdown.settings.end_date.label",
      "default": "2026-12-24",
      "info": "t:sections.countdown.settings.end_date.info"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "t:sections.countdown.settings.end_time.label",
      "default": "23:59",
      "info": "t:sections.countdown.settings.end_time.info"
    },
    {
      "type": "select",
      "id": "when_expired",
      "label": "t:sections.countdown.settings.when_expired.label",
      "options": [
        {
          "value": "hide",
          "label": "t:sections.countdown.settings.when_expired.options__1.label"
        },
        {
          "value": "message",
          "label": "t:sections.countdown.settings.when_expired.options__2.label"
        }
      ],
      "default": "hide"
    },
    {
      "type": "text",
      "id": "expired_text",
      "label": "t:sections.countdown.settings.expired_text.label",
      "default": "This edit has ended — new rituals are on the way."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.countdown.settings.kicker.label",
      "default": "The holiday edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.countdown.settings.heading.label",
      "default": "Gift sets, beautifully wrapped — for a little while."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.countdown.settings.text.label",
      "default": "<p>Limited-edition rituals with complimentary gift wrap.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.countdown.settings.button_label.label",
      "default": "Shop gift sets"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.countdown.settings.button_link.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.countdown.settings.color_scheme.label",
      "default": "scheme-7"
    },
    {
      "type": "color_scheme",
      "id": "section_scheme",
      "label": "t:sections.countdown.settings.section_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.countdown.presets.presets__1.name"
    }
  ]
}
{% endschema %}
