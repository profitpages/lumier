{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign show_filters = false
  if s.enable_filters and collection.filters.size > 0
    assign show_filters = true
  endif
  assign promo = nil
  for block in section.blocks
    if block.type == 'promo'
      assign promo = block
    endif
  endfor
-%}
<section class="section section--tight color-{{ s.color_scheme }}" id="ProductGrid" style="--cols: {{ s.columns }}; --cols-m: {{ s.columns_mobile }};">
  <div class="page-width">
    {%- paginate collection.products by s.per_page -%}
      <facet-form class="coll coll--{{ s.filter_layout }}{% unless show_filters %} coll--no-filters{% endunless %}">
        <div class="coll__bar">
          {%- assign tab_count = 0 -%}
          {%- for block in section.blocks -%}{%- if block.type == 'tab' -%}{%- assign tab_count = tab_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
          {%- if tab_count > 0 -%}
            <nav class="coll__tabs" aria-label="{{ 'collections.categories' | t }}">
              {%- assign all_marked = false -%}
              <ul role="list">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'tab' -%}
                    {%- assign tc = block.settings.collection -%}
                    {%- assign tab_label = block.settings.label | default: tc.title -%}
                    {%- assign tab_url = tc.url | default: routes.all_products_collection_url -%}
                    {%- assign is_current = false -%}
                    {%- if tc != blank and collection.handle == tc.handle -%}
                      {%- assign is_current = true -%}
                    {%- elsif tc == blank and collection.handle == 'all' and all_marked == false -%}
                      {%- assign is_current = true -%}
                      {%- assign all_marked = true -%}
                    {%- endif -%}
                    <li {{ block.shopify_attributes }}><a class="coll__tab{% if is_current %} is-active{% endif %}" href="{{ tab_url }}"{% if is_current %} aria-current="page"{% endif %}>{{ tab_label | escape }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </nav>
          {%- endif -%}
          <div class="coll__tools">
            {%- if show_filters -%}
              <button class="coll__filter-btn" type="button" data-filter-open aria-controls="FilterDrawer" aria-expanded="false"><span>{{ 'collections.filter' | t }}</span>{% render 'icon', name: 'filter', size: 16 %}</button>
            {%- else -%}
              <span class="coll__filter-btn coll__filter-btn--spacer" aria-hidden="true"></span>
            {%- endif -%}
            <p class="coll__bar-count">{{ 'collections.product_count_essentials' | t: count: collection.products_count }}</p>
            {%- if s.enable_sorting -%}
              <label class="coll__sort">
                <span>{{ 'collections.sort_by' | t }}</span>
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                <select class="select select--sm select--bare" name="sort_by" form="FacetsForm" data-facet-input>
                  {%- for option in collection.sort_options -%}<option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{%- endfor -%}
                </select>
              </label>
            {%- endif -%}
          </div>
        </div>

        {%- liquid
          assign has_active = false
          for filter in collection.filters
            if filter.active_values.size > 0
              assign has_active = true
            endif
            if filter.type == 'price_range'
              if filter.min_value.value != nil or filter.max_value.value != nil
                assign has_active = true
              endif
            endif
          endfor
        -%}
        <div class="coll__body">
          <form id="FacetsForm" class="coll__filters-form" action="{{ collection.url }}" method="get" data-facets-form{% unless show_filters %} hidden{% endunless %}>
            {%- if show_filters -%}
              <aside class="filters color-{{ s.filter_scheme }}" id="FilterDrawer" data-filter-panel aria-label="{{ 'collections.filters' | t }}">
                <div class="filters__head">
                  <h2 class="filters__title">{{ 'collections.refine' | t }}</h2>
                  {%- if has_active -%}<a class="filters__clear" href="{{ collection.url }}?sort_by={{ collection.sort_by }}">{{ 'collections.clear' | t }}</a>{%- endif -%}
                  <button class="icon-btn filters__close" type="button" data-filter-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close', size: 20 %}</button>
                </div>
                {%- for filter in collection.filters -%}
                  <details class="filter"{% if forloop.index <= s.open_filters or filter.active_values.size > 0 %} open{% endif %}>
                    <summary class="filter__title">{{ filter.label | escape }}{%- if filter.active_values.size > 0 -%}<span class="filter__count">{{ filter.active_values.size }}</span>{%- endif -%}{% render 'icon', name: 'chevron-down', size: 16 %}</summary>
                    <div class="filter__body">
                      {%- case filter.type -%}
                        {%- when 'price_range' -%}
                          <div class="filter__price">
                            <label><span>{{ 'collections.from' | t }}</span><input class="input input--sm" type="number" inputmode="decimal" min="0" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | remove: ',' }}" placeholder="0" data-facet-input></label>
                            <label><span>{{ 'collections.to' | t }}</span><input class="input input--sm" type="number" inputmode="decimal" min="0" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | remove: ',' }}" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}" data-facet-input></label>
                          </div>
                        {%- else -%}
                          <ul class="filter__options{% if filter.presentation == 'swatch' %} filter__options--swatch{% endif %}" role="list">
                            {%- for value in filter.values -%}
                              {%- assign disabled = false -%}
                              {%- if value.count == 0 and value.active == false -%}{%- assign disabled = true -%}{%- endif -%}
                              <li>
                                <label class="check{% if disabled %} is-disabled{% endif %}">
                                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if disabled %} disabled{% endif %} data-facet-input>
                                  {%- if filter.presentation == 'swatch' and value.swatch.color -%}
                                    <span class="swatch" style="--swatch: {{ value.swatch.color }};" aria-hidden="true"></span>
                                  {%- else -%}
                                    <span class="check__box" aria-hidden="true">{% render 'icon', name: 'check', size: 12 %}</span>
                                  {%- endif -%}
                                  <span class="check__label">{{ value.label | escape }}</span>
                                  <span class="check__n">{{ value.count }}</span>
                                </label>
                              </li>
                            {%- endfor -%}
                          </ul>
                      {%- endcase -%}
                    </div>
                  </details>
                {%- endfor -%}
                <div class="filters__foot">
                  <a class="btn btn--outline btn--sm" href="{{ collection.url }}">{{ 'collections.clear' | t }}</a>
                  <button class="btn btn--solid btn--sm" type="submit">{{ 'collections.apply' | t }}</button>
                </div>
              </aside>
            {%- endif -%}
          </form>

          <div class="coll__results" data-results>
            <div class="coll__meta">
              <p class="coll__count" role="status">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
              {%- if has_active -%}
                <ul class="active-filters" role="list">
                  {%- for filter in collection.filters -%}
                    {%- for v in filter.active_values -%}
                      <li><a class="chip chip--remove" href="{{ v.url_to_remove }}">{{ v.label | escape }}{% render 'icon', name: 'close', size: 12 %}<span class="visually-hidden">{{ 'collections.remove_filter' | t }}</span></a></li>
                    {%- endfor -%}
                    {%- if filter.type == 'price_range' -%}
                      {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                        <li><a class="chip chip--remove" href="{{ filter.url_to_remove }}">{{ filter.min_value.value | default: 0 | money }}–{{ filter.max_value.value | default: filter.range_max | money }}{% render 'icon', name: 'close', size: 12 %}</a></li>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- elsif s.note != blank -%}
                <p class="coll__note">{{ s.note | escape }}</p>
              {%- endif -%}
            </div>

            {%- if collection.products.size > 0 -%}
              <ul class="product-grid" role="list" data-grid>
                {%- for product in collection.products -%}
                  {%- if promo and forloop.index == promo.settings.position and paginate.current_page == 1 -%}
                    <li class="grid-promo color-{{ promo.settings.color_scheme }}" {{ promo.shopify_attributes }}>
                      <div class="grid-promo__media">{%- render 'responsive-image', image: promo.settings.image, max: 900, sizes: '(min-width: 990px) 30vw, 90vw', art: 'tube', tone: 'sand' -%}</div>
                      <div class="grid-promo__copy">
                        {%- if promo.settings.kicker != blank -%}<p class="kicker">{{ promo.settings.kicker | escape }}</p>{%- endif -%}
                        <h3 class="grid-promo__title">{{ promo.settings.heading | escape }}</h3>
                        {%- if promo.settings.text != blank -%}<div class="rte">{{ promo.settings.text }}</div>{%- endif -%}
                        {%- if promo.settings.link_label != blank -%}<a class="link-underline" href="{{ promo.settings.link | default: routes.collections_url }}">{{ promo.settings.link_label | escape }}</a>{%- endif -%}
                      </div>
                    </li>
                  {%- endif -%}
                  {%- assign lazy = true -%}
                  {%- if forloop.index <= 3 -%}{%- assign lazy = false -%}{%- endif -%}
                  <li class="product-grid__item">
                    {%- render 'product-card', product: product, style: s.card_style, ratio: s.image_ratio, show_vendor: s.show_vendor, show_quick_add: s.show_quick_add, lazy: lazy, section_id: section.id, sizes: '(min-width: 1100px) 24vw, (min-width: 750px) 33vw, 50vw' -%}
                  </li>
                {%- endfor -%}
              </ul>
              {%- render 'pagination', paginate: paginate, anchor: '#ProductGrid', load_more: s.load_more -%}
            {%- else -%}
              <div class="empty">
                <div class="empty__art">{%- render 'cosmetic-art', name: 'compact', tone: 'lilac' -%}</div>
                <h2 class="h3">{{ 'collections.empty_title' | t }}</h2>
                <p>{{ 'collections.empty_text' | t }}</p>
                <a class="btn btn--solid" href="{% if has_active %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{% if has_active %}{{ 'collections.clear' | t }}{% else %}{{ 'general.shop_all' | t }}{% endif %}</a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </facet-form>
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "class": "section-main-collection",
  "max_blocks": 8,
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 36, "step": 4, "default": 12 },
    { "type": "range", "id": "columns", "label": "Products per row (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select", "id": "columns_mobile", "label": "Products per row (mobile)",
      "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }],
      "default": "2"
    },
    { "type": "checkbox", "id": "load_more", "label": "Show 'Load more' button", "default": true, "info": "Numbered pages remain available for search engines." },
    { "type": "text", "id": "note", "label": "Note beside the count (sidebar layout)" },
    { "type": "header", "content": "Filters & sorting" },
    { "type": "checkbox", "id": "enable_filters", "label": "Enable filters", "default": true, "info": "Configure filters with the Shopify Search & Discovery app." },
    {
      "type": "select", "id": "filter_layout", "label": "Filter layout",
      "options": [{ "value": "drawer", "label": "Drawer (Filter button)" }, { "value": "sidebar", "label": "Sidebar on desktop" }],
      "default": "drawer"
    },
    { "type": "range", "id": "open_filters", "label": "Filter groups open by default", "min": 0, "max": 6, "step": 1, "default": 2 },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true },
    { "type": "header", "content": "Product cards" },
    {
      "type": "select", "id": "card_style", "label": "Card style",
      "options": [{ "value": "editorial", "label": "Editorial (paper frame)" }, { "value": "label", "label": "Boutique (label + button)" }, { "value": "rounded", "label": "Rounded (soft card)" }, { "value": "gallery", "label": "Gallery (frameless)" }],
      "default": "gallery"
    },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio",
      "options": [{ "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait 4:5" }, { "value": "tall", "label": "Tall 3:4" }],
      "default": "portrait"
    },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show quick add", "default": true },
    { "type": "color_scheme", "id": "filter_scheme", "label": "Filter panel color scheme", "default": "scheme-2" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "tab", "name": "Category tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty for 'All'." },
        { "type": "text", "id": "label", "label": "Label", "default": "All" }
      ]
    },
    {
      "type": "promo", "name": "Promo tile in grid", "limit": 1,
      "settings": [
        { "type": "range", "id": "position", "label": "Show before product", "min": 2, "max": 12, "step": 1, "default": 4 },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "The Lumière standard" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Formulas with intention" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every texture begins with an edit of efficacious botanicals and barrier-loving actives.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore ingredients" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" }
      ]
    }
  ]
}
{% endschema %}
