{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="section color-{{ s.section_scheme }}">
  <div class="page-width">
    <div class="richtext richtext--{{ s.alignment }}{% if s.card %} panel color-{{ s.color_scheme }}{% endif %}" style="max-width: {{ s.width }}px;">
      {%- if s.card -%}{%- render 'decor', preset: 'corner' -%}{%- endif -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'kicker' -%}<p class="kicker" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'heading' -%}
            <h2 class="{% if block.settings.size == 'display' %}display{% else %}h2{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
          {%- when 'text' -%}<div class="rte richtext__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'signature' -%}<p class="richtext__sign" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'buttons' -%}
            <div class="btn-row" {{ block.shopify_attributes }}>
              {%- render 'button', label: block.settings.label, url: block.settings.link, style: block.settings.style -%}
              {%- render 'button', label: block.settings.label2, url: block.settings.link2, style: 'outline' -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "class": "section-rich-text",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.rich-text.settings.alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.alignment.options__2.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "width",
      "label": "t:sections.rich-text.settings.width.label",
      "min": 500,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 800
    },
    {
      "type": "checkbox",
      "id": "card",
      "label": "t:sections.rich-text.settings.card.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.rich-text.settings.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "color_scheme",
      "id": "section_scheme",
      "label": "t:sections.rich-text.settings.section_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "kicker",
      "name": "t:sections.rich-text.blocks.kicker.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.rich-text.blocks.kicker.settings.text.label",
          "default": "Our philosophy"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.rich-text.blocks.heading.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label",
          "default": "Beauty that feels like a deep breath."
        },
        {
          "type": "select",
          "id": "size",
          "label": "t:sections.rich-text.blocks.heading.settings.size.label",
          "options": [
            {
              "value": "section",
              "label": "t:sections.rich-text.blocks.heading.settings.size.options__1.label"
            },
            {
              "value": "display",
              "label": "t:sections.rich-text.blocks.heading.settings.size.options__2.label"
            }
          ],
          "default": "section"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich-text.blocks.text.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.rich-text.blocks.text.settings.text.label",
          "default": "<p>We make fewer, better things: textures you look forward to, formulas that respect your skin, and packaging you'll want to keep.</p>"
        }
      ]
    },
    {
      "type": "signature",
      "name": "t:sections.rich-text.blocks.signature.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.rich-text.blocks.signature.settings.text.label",
          "default": "— The studio"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "t:sections.rich-text.blocks.buttons.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.rich-text.blocks.buttons.settings.label.label",
          "default": "Our story"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.rich-text.blocks.buttons.settings.link.label"
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:sections.rich-text.blocks.buttons.settings.style.label",
          "options": [
            {
              "value": "solid",
              "label": "t:sections.rich-text.blocks.buttons.settings.style.options__1.label"
            },
            {
              "value": "outline",
              "label": "t:sections.rich-text.blocks.buttons.settings.style.options__2.label"
            },
            {
              "value": "accent",
              "label": "t:sections.rich-text.blocks.buttons.settings.style.options__3.label"
            }
          ],
          "default": "solid"
        },
        {
          "type": "text",
          "id": "label2",
          "label": "t:sections.rich-text.blocks.buttons.settings.label2.label"
        },
        {
          "type": "url",
          "id": "link2",
          "label": "t:sections.rich-text.blocks.buttons.settings.link2.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich-text.presets.presets__1.name",
      "blocks": [
        {
          "type": "kicker"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "signature"
        }
      ]
    }
  ]
}
{% endschema %}
