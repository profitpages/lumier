{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="section color-{{ s.section_scheme }}">
  <div class="page-width">
    <div class="richtext richtext--{{ s.alignment }}{% if s.card %} panel color-{{ s.color_scheme }}{% endif %}" style="max-width: {{ s.width }}px;">
      {%- if s.card -%}{%- render 'decor', preset: 'corner' -%}{%- endif -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'kicker' -%}<p class="kicker" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'heading' -%}
            <h2 class="{% if block.settings.size == 'display' %}display{% else %}h2{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
          {%- when 'text' -%}<div class="rte richtext__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'signature' -%}<p class="richtext__sign" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'buttons' -%}
            <div class="btn-row" {{ block.shopify_attributes }}>
              {%- render 'button', label: block.settings.label, url: block.settings.link, style: block.settings.style -%}
              {%- render 'button', label: block.settings.label2, url: block.settings.link2, style: 'outline' -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "class": "section-rich-text",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select", "id": "alignment", "label": "Alignment",
      "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }],
      "default": "center"
    },
    { "type": "range", "id": "width", "label": "Max width", "min": 500, "max": 1200, "step": 50, "unit": "px", "default": 800 },
    { "type": "checkbox", "id": "card", "label": "Show inside a soft panel", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Panel color scheme", "default": "scheme-3" },
    { "type": "color_scheme", "id": "section_scheme", "label": "Section color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    { "type": "kicker", "name": "Kicker", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Our philosophy" }] },
    {
      "type": "heading", "name": "Heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Beauty that feels like a deep breath." },
        { "type": "select", "id": "size", "label": "Size", "options": [{ "value": "section", "label": "Section" }, { "value": "display", "label": "Large display" }], "default": "section" }
      ]
    },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>We make fewer, better things: textures you look forward to, formulas that respect your skin, and packaging you'll want to keep.</p>" }] },
    { "type": "signature", "name": "Signature", "settings": [{ "type": "text", "id": "text", "label": "Signature", "default": "— The studio" }] },
    {
      "type": "buttons", "name": "Buttons",
      "settings": [
        { "type": "text", "id": "label", "label": "Button label", "default": "Our story" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }, { "value": "accent", "label": "Accent" }], "default": "solid" },
        { "type": "text", "id": "label2", "label": "Second button label" },
        { "type": "url", "id": "link2", "label": "Second button link" }
      ]
    }
  ],
  "presets": [{ "name": "Rich text", "blocks": [{ "type": "kicker" }, { "type": "heading" }, { "type": "text" }, { "type": "signature" }] }]
}
{% endschema %}
