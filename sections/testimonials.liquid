{%- comment -%}
  Testimonials — merchant-entered customer words (never invented). For product reviews use the Reviews section.
  Layouts: community (quote slider + photo mosaic) | cards (grid) | single (centred quote band)
{%- endcomment -%}
{{ 'section-lumiere.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign first = section.blocks.first
-%}
<section class="section testi testi--{{ s.layout }} color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- case s.layout -%}
      {%- when 'community' -%}
        <div class="testi__grid">
          <quote-slider class="testi__slider" aria-roledescription="carousel" aria-label="{{ s.kicker | default: s.heading | escape }}">
            {%- if s.kicker != blank -%}<p class="kicker kicker--accent">{{ s.kicker | escape }}</p>{%- endif -%}
            <div class="testi__slides">
              {%- for block in section.blocks -%}
                {%- assign b = block.settings -%}
                <figure class="testi__slide" data-slide aria-roledescription="slide"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
                  {%- if b.stars > 0 -%}<span class="testi__stars" aria-label="{{ 'products.rating' | t: rating: b.stars, max: 5 }}">{%- for i in (1..b.stars) -%}★{%- endfor -%}</span>{%- endif -%}
                  <blockquote class="testi__quote">“{{ b.quote | escape }}”</blockquote>
                  <figcaption class="testi__by">{{ b.author | escape }}{%- if b.product != blank -%} · {{ b.product.title | escape }}{%- elsif b.detail != blank -%} · {{ b.detail | escape }}{%- endif -%}</figcaption>
                </figure>
              {%- endfor -%}
            </div>
            {%- if section.blocks.size > 1 -%}
              <div class="testi__nav">
                <button class="circle-btn circle-btn--bare" type="button" data-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left', size: 18 %}</button>
                <button class="circle-btn circle-btn--bare" type="button" data-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow-right', size: 18 %}</button>
              </div>
            {%- endif -%}
          </quote-slider>
          <div class="testi__mosaic">
            {%- assign mosaic_arts = 'portrait,pump,swatch' | split: ',' -%}
            {%- for i in (1..3) -%}
              {%- assign key = 'image_' | append: i -%}
              <div class="testi__tile">{%- render 'responsive-image', image: s[key], max: 700, sizes: '(min-width: 990px) 20vw, 45vw', art: mosaic_arts[forloop.index0], tone: 'linen' -%}</div>
            {%- endfor -%}
            <a class="testi__tile testi__tile--cta" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_label | escape }} <span aria-hidden="true">→</span></a>
          </div>
        </div>
      {%- when 'single' -%}
        <figure class="testi__single">
          <span class="testi__mark" aria-hidden="true">“</span>
          {%- if first -%}
            <blockquote class="testi__quote" {{ first.shopify_attributes }}>{{ first.settings.quote | escape }}</blockquote>
            <figcaption class="testi__by">{{ first.settings.author | escape }}{%- if first.settings.detail != blank %} — {{ first.settings.detail | escape }}{% endif -%}</figcaption>
          {%- endif -%}
        </figure>
      {%- else -%}
        <header class="sec-head testi__head">
          <div class="sec-head__main">
            {%- if s.kicker != blank -%}<p class="kicker kicker--accent">{{ s.kicker | escape }}</p>{%- endif -%}
            {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
          </div>
          {%- if s.summary != blank -%}<p class="testi__summary"><span class="testi__stars" aria-hidden="true">★★★★★</span>{{ s.summary | escape }}</p>{%- endif -%}
        </header>
        <ul class="quotes" role="list">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <li class="quote" data-reveal {{ block.shopify_attributes }}>
              <figure>
                {%- if b.stars > 0 -%}<span class="quote__stars" aria-label="{{ 'products.rating' | t: rating: b.stars, max: 5 }}">{%- for i in (1..b.stars) -%}★{%- endfor -%}</span>{%- endif -%}
                <blockquote class="quote__text">“{{ b.quote | escape }}”</blockquote>
                <figcaption class="quote__by">
                  {%- if b.avatar != blank -%}{{ b.avatar | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 40, height: 40, class: 'quote__avatar' }}{%- endif -%}
                  {{ b.author | escape }}{%- if b.detail != blank -%}<span>· {{ b.detail | escape }}</span>{%- endif -%}
                </figcaption>
                {%- if b.product != blank -%}<a class="quote__product link-underline link-underline--plain" href="{{ b.product.url }}">{{ b.product.title | escape }}</a>{%- endif -%}
              </figure>
            </li>
          {%- endfor -%}
        </ul>
    {%- endcase -%}
  </div>
</section>

{% schema %}
{
