{%- comment -%} Comparison table — row labels from a setting; each column lists values in order; yes/no become icons. {%- endcomment -%}
{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign rows = s.rows | newline_to_br | split: '<br />'
  assign arts = 'serum,jar,pump,tube' | split: ','
-%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: 'center' -%}
    <div class="cmp-wrap" role="region" aria-label="{{ s.heading | escape }}" tabindex="0">
      <table class="cmp">
        <thead>
          <tr>
            <td class="cmp__corner"></td>
            {%- for block in section.blocks -%}
              {%- assign b = block.settings -%}
              <th scope="col" class="cmp__col{% if b.highlight %} is-hl{% endif %}" {{ block.shopify_attributes }}>
                {%- if b.highlight and s.flag != blank -%}<span class="cmp__flag">{{ s.flag | escape }}</span>{%- endif -%}
                <span class="cmp__media">
                  {%- assign cmp_img = b.image | default: b.product.featured_media.preview_image -%}
                  {%- render 'responsive-image', image: cmp_img, max: 400, sizes: '140px', art: arts[forloop.index0], tone: 'blush' -%}
                </span>
                <span class="cmp__name">{{ b.title | default: b.product.title | escape }}</span>
                {%- if b.product != blank -%}{%- render 'price', product: b.product -%}{%- endif -%}
              </th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for row in rows -%}
            {%- assign label = row | strip -%}
            {%- if label != blank -%}
              {%- assign r = forloop.index0 -%}
              <tr>
                <th scope="row">{{ label | escape }}</th>
                {%- for block in section.blocks -%}
                  {%- assign vals = block.settings.values | newline_to_br | split: '<br />' -%}
                  {%- assign v = vals[r] | strip -%}
                  {%- assign vd = v | downcase -%}
                  <td class="{% if block.settings.highlight %}is-hl{% endif %}">
                    {%- if vd == 'yes' -%}<span class="cmp__yes">{% render 'icon', name: 'check', size: 15 %}<span class="visually-hidden">{{ 'sections.yes' | t }}</span></span>
                    {%- elsif vd == 'no' -%}<span class="cmp__no">—<span class="visually-hidden">{{ 'sections.no' | t }}</span></span>
                    {%- else -%}{{ v | escape }}{%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endif -%}
          {%- endfor -%}
          <tr class="cmp__actions">
            <td></td>
            {%- for block in section.blocks -%}
              <td class="{% if block.settings.highlight %}is-hl{% endif %}">
                {%- if block.settings.product != blank -%}
                  <a class="btn btn--sm {% if block.settings.highlight %}btn--solid{% else %}btn--outline{% endif %}" href="{{ block.settings.product.url }}">{{ 'products.view_details' | t }}</a>
                {%- endif -%}
              </td>
            {%- endfor -%}
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "class": "section-comparison",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Which one is yours?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare our serums" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "textarea", "id": "rows", "label": "Row labels", "default": "Best for\nTexture\nKey active\nFragrance-free\nUse AM\nUse PM", "info": "One per line. Columns list values in the same order; yes / no become icons." },
    { "type": "text", "id": "flag", "label": "Highlighted column flag", "default": "Most loved" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "column", "name": "Column",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the product title." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "textarea", "id": "values", "label": "Values (one per line)", "default": "Dull skin\nSilky gel\nVitamin C\nyes\nyes\nno" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight this column", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "column", "settings": { "title": "Bright Serum", "values": "Dull skin\nSilky gel\nVitamin C\nyes\nyes\nno" } },
        { "type": "column", "settings": { "title": "Peptide Serum", "values": "Fine lines\nMilky fluid\nPeptides\nyes\nyes\nyes", "highlight": true } },
        { "type": "column", "settings": { "title": "Night Oil", "values": "Dry skin\nSilky oil\nSqualane\nyes\nno\nyes" } }
      ]
    }
  ]
}
{% endschema %}
