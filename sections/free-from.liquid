{%- comment -%} Formulated without — the "free-from" promise as a hairline list. {%- endcomment -%}
{{ 'section-lumiere-more.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    <div class="free">
      <div class="free__copy">
        {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte free__text">{{ s.text }}</div>{%- endif -%}
        {%- render 'button', label: s.button_label, url: s.button_link, style: 'link' -%}
      </div>
      <ul class="free__list" role="list">
        {%- for block in section.blocks -%}
          <li class="free__item" {{ block.shopify_attributes }}>
            <svg class="free__mark" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M5.6 18.4 18.4 5.6"/></svg>
            <span class="free__label">{{ block.settings.label | escape }}</span>
            {%- if block.settings.note != blank -%}<span class="free__note">{{ block.settings.note | escape }}</span>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formulated without",
  "class": "section-free-from",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Our clean promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Formulated without." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>What we leave out matters as much as what we put in. Every formula is made without:</p>" },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Read our standards" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "item", "name": "Item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Parabens" },
        { "type": "text", "id": "note", "label": "Short note" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Formulated without",
      "blocks": [
        { "type": "item", "settings": { "label": "Parabens" } },
        { "type": "item", "settings": { "label": "Sulphates (SLS & SLES)" } },
        { "type": "item", "settings": { "label": "Synthetic fragrance" } },
        { "type": "item", "settings": { "label": "Mineral oil" } },
        { "type": "item", "settings": { "label": "Phthalates" } },
        { "type": "item", "settings": { "label": "Animal testing" } }
      ]
    }
  ]
}
{% endschema %}
