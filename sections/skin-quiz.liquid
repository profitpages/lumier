{%- comment -%}
  "Find your ritual" — 3-step skin quiz (skin type → concern → budget). Each answer carries a
  Search & Discovery filter parameter appended to the results collection URL.
{%- endcomment -%}
{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign results_url = s.collection.url | default: routes.all_products_collection_url
  assign steps = 'skin,concern,budget' | split: ','
-%}
<gift-finder class="section color-{{ s.section_scheme }}" data-results="{{ results_url }}">
  <div class="page-width">
    <div class="quiz">
      <div class="quiz__intro color-{{ s.color_scheme }}">
        {%- render 'decor', preset: 'hero' -%}
        <div class="quiz__intro-copy">
          {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
          <h2 class="h2">{{ s.heading | escape }}</h2>
          {%- if s.text != blank -%}<div class="rte quiz__text">{{ s.text }}</div>{%- endif -%}
        </div>
        <div class="quiz__art float-y" aria-hidden="true">{%- render 'cosmetic-art', name: 'serum', tone: 'lilac' -%}</div>
      </div>
      <div class="quiz__body">
        <ol class="quiz__progress" role="list" aria-label="{{ 'sections.quiz_progress' | t }}">
          {%- for step in steps -%}<li class="quiz__dot{% if forloop.first %} is-current{% endif %}" data-progress="{{ forloop.index0 }}"><span>{{ forloop.index }}</span></li>{%- endfor -%}
        </ol>
        {%- for step in steps -%}
          {%- assign q_key = 'q_' | append: step -%}
          <fieldset class="quiz__step" data-step="{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %}>
            <legend class="quiz__q">
              <span class="kicker">{{ 'sections.step_x_of_y' | t: index: forloop.index, count: 3 }}</span>
              {{ s[q_key] | escape }}
            </legend>
            <div class="quiz__options">
              {%- for block in section.blocks -%}
                {%- if block.type == step -%}
                  <button class="finder__option quiz__option" type="button" data-param="{{ block.settings.param | escape }}" {{ block.shopify_attributes }}>
                    <span class="quiz__icon">{%- render 'icon', name: block.settings.icon, size: 20 -%}</span>
                    <span class="quiz__label">{{ block.settings.label | escape }}{%- if block.settings.note != blank -%}<small>{{ block.settings.note | escape }}</small>{%- endif -%}</span>
                  </button>
                {%- endif -%}
              {%- endfor -%}
              <button class="finder__option quiz__option quiz__option--skip" type="button" data-param="">{{ 'sections.quiz_any' | t }}</button>
            </div>
            {%- unless forloop.first -%}<button class="link-underline" type="button" data-back>{% render 'icon', name: 'arrow-left', size: 16 %} {{ 'general.previous' | t }}</button>{%- endunless -%}
          </fieldset>
        {%- endfor -%}
        <div class="quiz__done" data-done hidden>
          <p class="quiz__q">{{ s.done_heading | escape }}</p>
          <div class="btn-row">
            <a class="btn btn--solid" href="{{ results_url }}" data-results-link>{{ s.button_label | escape }}{% render 'icon', name: 'arrow-right', size: 18 %}</a>
            <button class="btn btn--outline" type="button" data-restart>{{ 'sections.quiz_restart' | t }}</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</gift-finder>

