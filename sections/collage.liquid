{%- comment -%}
  Editorial collage — asymmetric mosaic. First tile is large; tiles can be an image, a product or a collection.
  Shapes cycle through Lumière frames (curved corner, arch, square).
{%- endcomment -%}
{{ 'section-lumiere-more.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign arts = 'portrait,serum,jar,swatch' | split: ','
-%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text -%}
    <div class="collage collage--{{ s.layout }}">
      {%- for block in section.blocks limit: 3 -%}
        {%- liquid
          assign b = block.settings
          assign i = forloop.index0
          assign url = b.link
          assign title = b.title
          assign img = b.image
          case block.type
            when 'product'
              assign url = url | default: b.product.url
              assign title = title | default: b.product.title
              assign img = img | default: b.product.featured_media.preview_image
            when 'collection'
              assign url = url | default: b.collection.url
              assign title = title | default: b.collection.title
              assign img = img | default: b.collection.featured_image
          endcase
          assign shape = 'square'
          if i == 0
            assign shape = 'corner'
          elsif i == 1
            assign shape = 'arch'
          endif
        -%}
        <a class="collage__tile collage__tile--{{ i | plus: 1 }}" href="{{ url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <span class="collage__media frame frame--{{ shape }}">
            {%- render 'responsive-image', image: img, max: 1400, sizes: '(min-width: 990px) 45vw, 92vw', class: 'collage__img', art: arts[i], tone: 'linen' -%}
          </span>
          <span class="collage__body">
            {%- if b.kicker != blank -%}<span class="kicker">{{ b.kicker | escape }}</span>{%- endif -%}
            {%- if title != blank -%}<span class="collage__title">{{ title | escape }}</span>{%- endif -%}
            {%- if block.type == 'product' and b.product != blank -%}{%- render 'price', product: b.product -%}{%- endif -%}
            {%- if b.link_label != blank -%}<span class="collage__go">{{ b.link_label | escape }}</span>{%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial collage",
  "class": "section-collage",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Beautifully considered, end to end." },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [{ "value": "left", "label": "Large tile on the left" }, { "value": "right", "label": "Large tile on the right" }],
      "default": "left"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "image", "name": "Image tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "New season" },
        { "type": "text", "id": "title", "label": "Title", "default": "The soft-focus edit" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "product", "name": "Product tile",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Cult favourite" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the product title." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Custom link" }
      ]
    },
    {
      "type": "collection", "name": "Collection tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Custom link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial collage",
      "blocks": [
        { "type": "image" },
        { "type": "product" },
        { "type": "collection", "settings": { "title": "Body rituals" } }
      ]
    }
  ]
}
{% endschema %}
