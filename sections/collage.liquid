      "label": "t:sections.collage.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.collage.blocks.image.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collage.blocks.image.settings.image.label"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.collage.blocks.image.settings.kicker.label",
          "default": "New season"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.collage.blocks.image.settings.title.label",
          "default": "The soft-focus edit"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.collage.blocks.image.settings.link_label.label",
          "default": "Discover"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.collage.blocks.image.settings.link.label"
        }
      ]
    },
    {
      "type": "product",
      "name": "t:sections.collage.blocks.product.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.collage.blocks.product.settings.product.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collage.blocks.product.settings.image.label"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.collage.blocks.product.settings.kicker.label",
          "default": "Cult favourite"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.collage.blocks.product.settings.title.label",
          "info": "t:sections.collage.blocks.product.settings.title.info"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.collage.blocks.product.settings.link_label.label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.collage.blocks.product.settings.link.label"
        }
      ]
    },
    {
      "type": "collection",
      "name": "t:sections.collage.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collage.blocks.collection.settings.collection.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collage.blocks.collection.settings.image.label"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.collage.blocks.collection.settings.kicker.label",
          "default": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.collage.blocks.collection.settings.title.label",
          "info": "t:sections.collage.blocks.collection.settings.title.info"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.collage.blocks.collection.settings.link_label.label",
