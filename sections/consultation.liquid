{%- comment -%} Book a consultation / visit the atelier — arch image, copy, detail rows (hours, address, contact) and buttons. {%- endcomment -%}
{{ 'section-lumiere-more.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="section color-{{ s.color_scheme }}">
  {%- render 'decor', preset: 'corner' -%}
  <div class="page-width">
    <div class="consult{% if s.image_right %} consult--image-right{% endif %}">
      <div class="consult__media">
        <div class="consult__frame frame frame--arch has-slab">
          {%- render 'responsive-image', image: s.image, max: 1200, sizes: '(min-width: 990px) 36vw, 80vw', art: 'portrait', tone: 'blush' -%}
        </div>
        {%- if s.caption != blank -%}<span class="caption-chip caption-chip--serif consult__caption">{{ s.caption | escape }}</span>{%- endif -%}
      </div>
      <div class="consult__copy">
        {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte consult__text">{{ s.text }}</div>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <dl class="consult__details">
            {%- for block in section.blocks -%}
              <div class="consult__row" {{ block.shopify_attributes }}>
                <dt>{%- render 'icon', name: block.settings.icon, size: 18 -%}<span>{{ block.settings.label | escape }}</span></dt>
                <dd class="rte">{{ block.settings.value }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        {%- endif -%}
        <div class="btn-row">
          {%- render 'button', label: s.button_label, url: s.button_link, style: 'solid' -%}
          {%- render 'button', label: s.button2_label, url: s.button2_link, style: 'outline' -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.consultation.name",
  "class": "section-consultation",
  "max_blocks": 5,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.consultation.settings.image.label"
    },
    {
      "type": "checkbox",
      "id": "image_right",
      "label": "t:sections.consultation.settings.image_right.label",
      "default": false
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:sections.consultation.settings.caption.label",
      "default": "Complimentary, by appointment."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.consultation.settings.kicker.label",
      "default": "One-to-one"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.consultation.settings.heading.label",
      "default": "Book a skin consultation."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.consultation.settings.text.label",
      "default": "<p>Twenty unhurried minutes with a Lumière specialist — in the atelier or by video — to build a ritual around your skin.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.consultation.settings.button_label.label",
      "default": "Book a time"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.consultation.settings.button_link.label",
      "info": "t:sections.consultation.settings.button_link.info"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "t:sections.consultation.settings.button2_label.label",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "t:sections.consultation.settings.button2_link.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.consultation.settings.color_scheme.label",
      "default": "scheme-5"
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "t:sections.consultation.blocks.detail.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.consultation.blocks.detail.settings.icon.label",
          "options": [
            {
              "value": "clock",
              "label": "t:sections.consultation.blocks.detail.settings.icon.options__1.label"
            },
            {
              "value": "user",
              "label": "t:sections.consultation.blocks.detail.settings.icon.options__2.label"
            },
            {
              "value": "mail",
              "label": "t:sections.consultation.blocks.detail.settings.icon.options__3.label"
            },
            {
              "value": "gift",
              "label": "t:sections.consultation.blocks.detail.settings.icon.options__4.label"
            },
            {
              "value": "sparkle",
              "label": "t:sections.consultation.blocks.detail.settings.icon.options__5.label"
            },
            {
              "value": "hand",
              "label": "t:sections.consultation.blocks.detail.settings.icon.options__6.label"
            }
          ],
          "default": "clock"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.consultation.blocks.detail.settings.label.label",
          "default": "Hours"
        },
        {
          "type": "richtext",
          "id": "value",
          "label": "t:sections.consultation.blocks.detail.settings.value.label",
          "default": "<p>Tuesday – Saturday, 10am – 6pm</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.consultation.presets.presets__1.name",
      "blocks": [
        {
          "type": "detail"
        },
        {
          "type": "detail",
          "settings": {
            "icon": "user",
            "label": "The atelier",
            "value": "<p>Add your studio address here</p>"
          }
        },
        {
          "type": "detail",
          "settings": {
            "icon": "mail",
            "label": "Questions",
            "value": "<p>hello@yourstore.com</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
