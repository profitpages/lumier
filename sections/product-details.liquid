{%- comment -%} Product details accordion — rows read product metafields where chosen; empty rows hide. {%- endcomment -%}
{{ 'section-lumiere.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="section section--tight color-{{ s.color_scheme }}">
  <div class="page-width">
    <div class="faq faq--side">
      <header class="sec-head">
        <div class="sec-head__main">
          {%- if s.kicker != blank -%}<p class="kicker kicker--accent">{{ s.kicker | escape }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
        </div>
      </header>
      <div class="accordion-list">
        {%- for block in section.blocks -%}
          {%- render 'detail-row', block: block, product: product, compact: false -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.product-details.name",
  "class": "section-product-details",
  "max_blocks": 12,
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.product-details.settings.kicker.label",
      "default": "Good to know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product-details.settings.heading.label",
      "default": "Every last detail."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.product-details.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.product-details.blocks.row.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.product-details.blocks.row.settings.heading.label",
          "default": "The ritual"
        },
        {
          "type": "select",
          "id": "source",
          "label": "t:sections.product-details.blocks.row.settings.source.label",
          "options": [
            {
              "value": "custom",
              "label": "t:sections.product-details.blocks.row.settings.source.options__1.label"
            },
            {
              "value": "description",
              "label": "t:sections.product-details.blocks.row.settings.source.options__2.label"
            },
            {
              "value": "ingredients",
              "label": "t:sections.product-details.blocks.row.settings.source.options__3.label"
            },
            {
              "value": "how_to_use",
              "label": "t:sections.product-details.blocks.row.settings.source.options__4.label"
            },
            {
              "value": "results",
              "label": "t:sections.product-details.blocks.row.settings.source.options__5.label"
            },
            {
              "value": "skin_type",
              "label": "t:sections.product-details.blocks.row.settings.source.options__6.label"
            },
            {
              "value": "size",
              "label": "t:sections.product-details.blocks.row.settings.source.options__7.label"
            }
          ],
          "default": "description"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.product-details.blocks.row.settings.content.label",
          "info": "t:sections.product-details.blocks.row.settings.content.info"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:sections.product-details.blocks.row.settings.page.label",
          "info": "t:sections.product-details.blocks.row.settings.page.info"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "t:sections.product-details.blocks.row.settings.open.label",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.product-details.presets.presets__1.name",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "heading": "The ritual",
            "source": "description",
            "open": true
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "Inside the bottle",
            "source": "ingredients"
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "How to use",
            "source": "how_to_use"
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "Clinical results",
            "source": "results"
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "Skin type",
            "source": "skin_type"
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "Size",
            "source": "size"
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "Shipping & returns",
            "source": "custom",
            "content": "<p>Orders are prepared within 24 hours on business days. Unopened products can be returned within 30 days.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
