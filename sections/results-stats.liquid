{%- comment -%} Clinical / consumer results — large serif figures with a required study note. Use only your own verified data. {%- endcomment -%}
{{ 'section-lumiere-more.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    <div class="stats{% if s.show_image %} stats--image{% endif %}">
      {%- if s.show_image -%}
        <div class="stats__media frame frame--arch has-slab">
          {%- render 'responsive-image', image: s.image, max: 1000, sizes: '(min-width: 990px) 30vw, 70vw', art: 'serum', tone: 'champagne' -%}
        </div>
      {%- endif -%}
      <div class="stats__body">
        <header class="stats__head">
          {%- if s.kicker != blank -%}<p class="kicker kicker--accent">{{ s.kicker | escape }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
        </header>
        <ul class="stats__list" role="list" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
          {%- for block in section.blocks -%}
            <li class="stat" data-reveal {{ block.shopify_attributes }}>
              <span class="stat__num">{{ block.settings.figure | escape }}</span>
              <span class="stat__label">{{ block.settings.label | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
        {%- if s.note != blank -%}<p class="stats__note">{{ s.note | escape }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Results",
  "class": "section-results",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "After four weeks" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Results you can see in the light." },
    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "note", "label": "Study note", "default": "Example figures — replace with results from your own consumer or clinical study, including the number of participants and duration." },
    { "type": "paragraph", "content": "Only publish figures from studies you have run or have the rights to cite." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" }
  ],
  "blocks": [
    {
      "type": "stat", "name": "Result",
      "settings": [
        { "type": "text", "id": "figure", "label": "Figure", "default": "94%" },
        { "type": "text", "id": "label", "label": "Label", "default": "said skin felt more hydrated" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Results",
      "blocks": [
        { "type": "stat", "settings": { "figure": "94%", "label": "said skin felt more hydrated" } },
        { "type": "stat", "settings": { "figure": "89%", "label": "saw a more radiant-looking finish" } },
        { "type": "stat", "settings": { "figure": "8 hrs", "label": "of comfortable moisture" } }
      ]
    }
  ]
}
{% endschema %}
