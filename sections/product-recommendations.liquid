{%- comment -%}
  "You may also like" (related) or "Pair it with / Complete your routine" (complementary — set in Search & Discovery).
  Loaded asynchronously through the Section Rendering API.
{%- endcomment -%}
{%- assign s = section.settings -%}
<product-recommendations
  class="section color-{{ s.color_scheme }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent={{ s.intent }}"
  style="--cols: {{ s.columns }}; --cols-m: 2;"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    {%- assign is_rail = false -%}
    {%- if s.layout == 'carousel' -%}{%- assign is_rail = true -%}{%- endif -%}
    <div class="page-width">
      {%- render 'section-heading', kicker: s.kicker, title: s.heading, arrows: is_rail -%}
      <rail-slider class="{% if is_rail %}rail{% else %}grid-wrap{% endif %}">
        <ul class="{% if is_rail %}rail__track{% else %}product-grid{% endif %}" role="list" data-rail-track>
          {%- for rec in recommendations.products -%}
            <li class="product-grid__item">{%- render 'product-card', product: rec, style: s.card_style, show_quick_add: true, section_id: section.id -%}</li>
          {%- endfor -%}
        </ul>
      </rail-slider>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "t:sections.product-recommendations.name",
  "class": "section-recommendations",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "intent",
      "label": "t:sections.product-recommendations.settings.intent.label",
      "options": [
        {
          "value": "complementary",
          "label": "t:sections.product-recommendations.settings.intent.options__1.label"
        },
        {
          "value": "related",
          "label": "t:sections.product-recommendations.settings.intent.options__2.label"
        }
      ],
      "default": "related",
      "info": "t:sections.product-recommendations.settings.intent.info"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.product-recommendations.settings.kicker.label",
      "default": "Complete the ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product-recommendations.settings.heading.label",
      "default": "Pairs beautifully with."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:sections.product-recommendations.settings.limit.label",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.product-recommendations.settings.columns.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.product-recommendations.settings.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.product-recommendations.settings.layout.options__1.label"
        },
        {
          "value": "carousel",
          "label": "t:sections.product-recommendations.settings.layout.options__2.label"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:sections.product-recommendations.settings.card_style.label",
      "options": [
        {
          "value": "editorial",
          "label": "t:sections.product-recommendations.settings.card_style.options__1.label"
        },
        {
          "value": "label",
          "label": "t:sections.product-recommendations.settings.card_style.options__2.label"
        },
        {
          "value": "rounded",
          "label": "t:sections.product-recommendations.settings.card_style.options__3.label"
        },
        {
          "value": "gallery",
          "label": "t:sections.product-recommendations.settings.card_style.options__4.label"
        }
      ],
      "default": "rounded"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.product-recommendations.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.product-recommendations.presets.presets__1.name"
    }
  ]
}
{% endschema %}
