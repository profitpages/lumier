{%- comment -%}
  "You may also like" (related) or "Pair it with / Complete your routine" (complementary — set in Search & Discovery).
  Loaded asynchronously through the Section Rendering API.
{%- endcomment -%}
{%- assign s = section.settings -%}
<product-recommendations
  class="section color-{{ s.color_scheme }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent={{ s.intent }}"
  style="--cols: {{ s.columns }}; --cols-m: 2;"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    {%- assign is_rail = false -%}
    {%- if s.layout == 'carousel' -%}{%- assign is_rail = true -%}{%- endif -%}
    <div class="page-width">
      {%- render 'section-heading', kicker: s.kicker, title: s.heading, arrows: is_rail -%}
      <rail-slider class="{% if is_rail %}rail{% else %}grid-wrap{% endif %}">
        <ul class="{% if is_rail %}rail__track{% else %}product-grid{% endif %}" role="list" data-rail-track>
          {%- for rec in recommendations.products -%}
            <li class="product-grid__item">{%- render 'product-card', product: rec, style: s.card_style, show_quick_add: true, section_id: section.id -%}</li>
          {%- endfor -%}
        </ul>
      </rail-slider>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Product recommendations",
  "class": "section-recommendations",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "select", "id": "intent", "label": "Type",
      "options": [
        { "value": "complementary", "label": "Complementary (Pair it with)" },
        { "value": "related", "label": "Related (You may also like)" }
      ],
      "default": "related",
      "info": "Complementary products are chosen in the Search & Discovery app."
    },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Complete the ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pairs beautifully with." },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 10, "step": 1, "default": 3 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 3 },
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [{ "value": "grid", "label": "Grid" }, { "value": "carousel", "label": "Carousel" }],
      "default": "grid"
    },
    {
      "type": "select", "id": "card_style", "label": "Card style",
      "options": [{ "value": "editorial", "label": "Editorial (paper frame)" }, { "value": "label", "label": "Boutique (label + button)" }, { "value": "rounded", "label": "Rounded (soft card)" }, { "value": "gallery", "label": "Gallery (frameless)" }],
      "default": "rounded"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
