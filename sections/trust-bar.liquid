{%- assign s = section.settings -%}
<section class="trust color-{{ s.color_scheme }}{% if s.bold %} trust--bold{% endif %}" style="border-block: 1px solid color-mix(in srgb, var(--text) 9%, transparent);">
  <div class="page-width">
    <ul class="trust__list" role="list" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <li class="trust__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}{%- render 'icon', name: block.settings.icon, size: 18 -%}{%- endif -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" style="text-decoration: none;">{{ block.settings.text | escape }}</a>
          {%- else -%}
            <span>{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.trust-bar.name",
  "class": "section-trust",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "bold",
      "label": "t:sections.trust-bar.settings.bold.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.trust-bar.settings.color_scheme.label",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.trust-bar.blocks.item.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.trust-bar.blocks.item.settings.text.label",
          "default": "Thoughtfully formulated"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.trust-bar.blocks.item.settings.icon.label",
          "options": [
            {
              "value": "none",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__1.label"
            },
            {
              "value": "sparkle",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__2.label"
            },
            {
              "value": "leaf",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__3.label"
            },
            {
              "value": "rabbit",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__4.label"
            },
            {
              "value": "recycle",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__5.label"
            },
            {
              "value": "truck",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__6.label"
            },
            {
              "value": "return",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__7.label"
            },
            {
              "value": "shield",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__8.label"
            },
            {
              "value": "flask",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__9.label"
            }
          ],
          "default": "none"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.trust-bar.blocks.item.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.trust-bar.presets.presets__1.name",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Thoughtfully formulated"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Cruelty-free essentials"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Beauty, made beautifully"
          }
        }
      ]
    }
  ]
}
{% endschema %}
