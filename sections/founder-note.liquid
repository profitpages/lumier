{%- comment -%} A note from our founder — portrait arch, letter-style text, signature. {%- endcomment -%}
{{ 'section-lumiere-more.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    <figure class="note{% if s.image_right %} note--image-right{% endif %}">
      <div class="note__media">
        <div class="note__frame frame frame--arch has-slab">
          {%- render 'responsive-image', image: s.image, max: 900, sizes: '(min-width: 990px) 28vw, 60vw', art: 'portrait', tone: 'blush' -%}
        </div>
        {%- if settings.decor_enable -%}<span class="dot-accent note__dot" aria-hidden="true"></span>{%- endif -%}
      </div>
      <div class="note__body">
        {%- if s.kicker != blank -%}<p class="kicker kicker--accent">{{ s.kicker | escape }}</p>{%- endif -%}
        <blockquote class="note__text rte">{{ s.text }}</blockquote>
        <figcaption class="note__by">
          {%- if s.signature != blank -%}<span class="note__sign">{{ s.signature | escape }}</span>{%- endif -%}
          {%- if s.name != blank -%}<span class="note__name">{{ s.name | escape }}</span>{%- endif -%}
        </figcaption>
        {%- render 'button', label: s.button_label, url: s.button_link, style: 'link' -%}
      </div>
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.founder-note.name",
  "class": "section-founder-note",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.founder-note.settings.image.label"
    },
    {
      "type": "checkbox",
      "id": "image_right",
      "label": "t:sections.founder-note.settings.image_right.label",
      "default": false
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.founder-note.settings.kicker.label",
      "default": "A note from our founder"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.founder-note.settings.text.label",
      "default": "<p>I started Lumière because the most luxurious part of my day was never the products themselves — it was the quiet five minutes I gave myself with them. Every formula is made to protect that moment.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "t:sections.founder-note.settings.signature.label",
      "default": "With warmth,"
    },
    {
      "type": "text",
      "id": "name",
      "label": "t:sections.founder-note.settings.name.label",
      "default": "Your name, Founder"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.founder-note.settings.button_label.label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.founder-note.settings.button_link.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.founder-note.settings.color_scheme.label",
      "default": "scheme-4"
    }
  ],
  "presets": [
    {
      "name": "t:sections.founder-note.presets.presets__1.name"
    }
  ]
}
{% endschema %}
