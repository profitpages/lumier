{%- comment -%}
  Image with text / brand story. Block-based copy (kicker, heading, text, list, button).
  Layouts: corner (curved-corner frame) | arch (arch + champagne slab) | offset (offset blush slab, outline) | full (full-bleed split)
{%- endcomment -%}
{{ 'section-story.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign frame_class = 'frame--corner has-shadow'
  case s.layout
    when 'arch'
      assign frame_class = 'frame--arch has-slab'
    when 'offset'
      assign frame_class = 'frame--square'
    when 'full'
      assign frame_class = ''
  endcase
-%}
<section class="story story--{{ s.layout }}{% if s.image_right %} story--image-right{% endif %}{% if s.layout != 'full' %} section{% endif %} color-{{ s.color_scheme }}">
  <div class="story__grid{% if s.layout != 'full' %} page-width{% endif %}">
    <div class="story__media">
      {%- if s.layout == 'offset' -%}<span class="story__slab" aria-hidden="true"></span>{%- endif -%}
      <div class="story__frame frame {{ frame_class }}">
        {%- render 'responsive-image', image: s.image, max: 1600, sizes: '(min-width: 990px) 50vw, 100vw', class: 'story__img', art: s.art, tone: 'blush' -%}
      </div>
      {%- if s.show_dot -%}<span class="dot-accent story__dot" aria-hidden="true"></span>{%- endif -%}
      {%- if s.caption != blank -%}<span class="caption-chip caption-chip--serif story__caption">{{ s.caption | escape }}</span>{%- endif -%}
    </div>

    <div class="story__copy">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'kicker' -%}
            <p class="kicker" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'heading' -%}
            <h2 class="{% if block.settings.size == 'sm' %}h3{% else %}h2{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
          {%- when 'text' -%}
            <div class="rte story__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'benefits' -%}
            {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
            <ul class="tick-list" role="list" {{ block.shopify_attributes }}>
              {%- for item in items -%}{%- assign it = item | strip -%}{%- if it != blank -%}<li>{{ it | escape }}</li>{%- endif -%}{%- endfor -%}
            </ul>
          {%- when 'button' -%}
            <div class="story__cta" {{ block.shopify_attributes }}>{%- render 'button', label: block.settings.label, url: block.settings.link, style: block.settings.style -%}</div>
          {%- when 'product' -%}
            {%- assign p = block.settings.product -%}
            {%- if p != blank -%}
              <a class="story__product" href="{{ p.url }}" {{ block.shopify_attributes }}>
                <span class="story__product-media">{%- render 'responsive-image', image: p.featured_media.preview_image, max: 200, sizes: '64px', art: 'serum' -%}</span>
                <span><span class="story__product-title">{{ p.title | escape }}</span>{%- render 'price', product: p -%}</span>
              </a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.story.name",
  "class": "section-story",
  "max_blocks": 8,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.story.settings.image.label"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.story.settings.layout.label",
      "options": [
        {
          "value": "corner",
          "label": "t:sections.story.settings.layout.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.story.settings.layout.options__2.label"
        },
        {
          "value": "offset",
          "label": "t:sections.story.settings.layout.options__3.label"
        },
        {
          "value": "full",
          "label": "t:sections.story.settings.layout.options__4.label"
        }
      ],
      "default": "corner"
    },
    {
      "type": "checkbox",
      "id": "image_right",
      "label": "t:sections.story.settings.image_right.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dot",
      "label": "t:sections.story.settings.show_dot.label",
      "default": false
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:sections.story.settings.caption.label"
    },
    {
      "type": "select",
      "id": "art",
      "label": "t:sections.story.settings.art.label",
      "options": [
        {
          "value": "pump",
          "label": "t:sections.story.settings.art.options__1.label"
        },
        {
          "value": "serum",
          "label": "t:sections.story.settings.art.options__2.label"
        },
        {
          "value": "jar",
          "label": "t:sections.story.settings.art.options__3.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.story.settings.art.options__4.label"
        }
      ],
      "default": "pump"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.story.settings.color_scheme.label",
      "default": "scheme-4"
    }
  ],
  "blocks": [
    {
      "type": "kicker",
      "name": "t:sections.story.blocks.kicker.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.story.blocks.kicker.settings.text.label",
          "default": "The Lumière point of view"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.story.blocks.heading.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.story.blocks.heading.settings.heading.label",
          "default": "Everyday luxury, considered."
        },
        {
          "type": "select",
          "id": "size",
          "label": "t:sections.story.blocks.heading.settings.size.label",
          "options": [
            {
              "value": "lg",
              "label": "t:sections.story.blocks.heading.settings.size.options__1.label"
            },
            {
              "value": "sm",
              "label": "t:sections.story.blocks.heading.settings.size.options__2.label"
            }
          ],
          "default": "lg"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.story.blocks.text.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.story.blocks.text.settings.text.label",
          "default": "<p>Thoughtful formulas and considered rituals bring a little more pleasure to the everyday. We favour responsible packaging choices and lasting essentials over excess.</p>"
        }
      ]
    },
    {
      "type": "benefits",
      "name": "t:sections.story.blocks.benefits.name",
      "settings": [
        {
          "type": "textarea",
          "id": "items",
          "label": "t:sections.story.blocks.benefits.settings.items.label",
          "default": "Carefully considered formulas\nReusable and recyclable packaging where available\nBeauty rituals made for real life"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.story.blocks.button.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.story.blocks.button.settings.label.label",
          "default": "Our story"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.story.blocks.button.settings.link.label"
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:sections.story.blocks.button.settings.style.label",
          "options": [
            {
              "value": "outline",
              "label": "t:sections.story.blocks.button.settings.style.options__1.label"
            },
            {
              "value": "solid",
              "label": "t:sections.story.blocks.button.settings.style.options__2.label"
            },
            {
              "value": "link",
              "label": "t:sections.story.blocks.button.settings.style.options__3.label"
            }
          ],
          "default": "outline"
        }
      ]
    },
    {
      "type": "product",
      "name": "t:sections.story.blocks.product.name",
      "limit": 1,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.story.blocks.product.settings.product.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.story.presets.presets__1.name",
      "blocks": [
        {
          "type": "kicker"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "benefits"
        },
        {
          "type": "button"
        }
      ]
    },
    {
      "name": "t:sections.story.presets.presets__2.name",
      "settings": {
        "layout": "offset",
        "image_right": false,
        "art": "serum"
      },
      "blocks": [
        {
          "type": "kicker",
          "settings": {
            "text": "Skin first"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "Your skin, in its best light."
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Our skincare brings thoughtful textures, clinically minded ingredients, and the pleasure of a slow morning together.</p>"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Explore skincare"
          }
        }
      ]
    },
    {
      "name": "t:sections.story.presets.presets__3.name",
      "settings": {
        "layout": "full",
        "image_right": false,
        "art": "jar"
      },
      "blocks": [
        {
          "type": "kicker",
          "settings": {
            "text": "The Lumière standard"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "Formulas with intention",
            "size": "sm"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Every texture begins with an edit of efficacious botanicals, barrier-loving actives, and sensorial details worth returning to.</p>"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Explore ingredients",
            "style": "link"
          }
        }
      ]
    }
  ]
}
{% endschema %}
