{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
{%- assign arts = 'serum,jar,compact,pump,tube,lipstick' | split: ',' -%}
{%- assign tones = 'blush,lilac,peach,sand,blush,lilac' | split: ',' -%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: s.heading_align -%}
    <ul class="mcol mcol--{{ s.style }} mcol--{{ s.text_align }}{% if s.swipe %} mcol--swipe{% endif %}" role="list" style="--cols: {{ s.columns }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign i = forloop.index0 | modulo: 6 -%}
        <li class="mcol__item" data-reveal {{ block.shopify_attributes }}>
          <div class="mcol__media mcol__media--{{ s.shape }}">
            {%- render 'responsive-image', image: b.image, max: 900, sizes: '(min-width: 990px) 30vw, 80vw', class: 'mcol__img', art: arts[i], tone: tones[i] -%}
          </div>
          <div class="mcol__body">
            {%- if b.title != blank -%}<h3 class="mcol__title">{{ b.title | escape }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<div class="rte mcol__text">{{ b.text }}</div>{%- endif -%}
            {%- if b.link_label != blank -%}<a class="link-underline" href="{{ b.link | default: routes.all_products_collection_url }}">{{ b.link_label | escape }} {% render 'icon', name: 'arrow-right', size: 15 %}</a>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.button_label != blank -%}<div class="btn-row btn-row--center mcol__cta">{%- render 'button', label: s.button_label, url: s.button_link, style: 'solid' -%}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Multicolumn",
  "class": "section-multicolumn",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rituals for every moment." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 3 },
    {
      "type": "select", "id": "style", "label": "Style",
      "options": [{ "value": "card", "label": "Soft cards" }, { "value": "open", "label": "Open (image + text)" }],
      "default": "card"
    },
    {
      "type": "select", "id": "shape", "label": "Image shape",
      "options": [{ "value": "landscape", "label": "Landscape" }, { "value": "portrait", "label": "Portrait" }, { "value": "arch", "label": "Arch" }, { "value": "circle", "label": "Circle" }],
      "default": "landscape"
    },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "checkbox", "id": "swipe", "label": "Swipe on mobile", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "column", "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Morning" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Light layers and SPF for a fresh, protected glow.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop AM" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column" },
        { "type": "column", "settings": { "title": "Evening", "text": "<p>Richer textures that replenish while you rest.</p>", "link_label": "Shop PM" } },
        { "type": "column", "settings": { "title": "On the go", "text": "<p>Minis and balms for a glow between meetings.</p>", "link_label": "Shop minis" } }
      ]
    }
  ]
}
{% endschema %}
