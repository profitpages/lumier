{%- comment -%}
  Short-form video reviews (TikTok / Reels style). 9:16 cards in a swipeable rail; videos play muted
  while in view (or on tap) and can be unmuted. Each card can tag a product.
{%- endcomment -%}
{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
{%- assign tones = 'blush,lilac,peach,sand,sage,blush' | split: ',' -%}
{%- assign arts = 'serum,jar,lipstick,pump,tube,compact' | split: ',' -%}
<video-reviews class="section color-{{ s.color_scheme }}" data-autoplay="{{ s.autoplay }}">
  {%- render 'decor', preset: 'band' -%}
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, arrows: true -%}
    <ul class="vrev rail__track" data-rail-track role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign i = forloop.index0 | modulo: 6 -%}
        <li class="vrev__item" {{ block.shopify_attributes }}>
          <article class="vrev__card">
            <div class="vrev__screen" data-vrev-screen>
              {%- if b.video != blank -%}
                {{ b.video | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', class: 'vrev__video', image_size: '600x' }}
              {%- elsif b.video_url != blank -%}
                <video class="vrev__video" src="{{ b.video_url }}" muted loop playsinline preload="none"{% if b.poster != blank %} poster="{{ b.poster | image_url: width: 600 }}"{% endif %}></video>
              {%- elsif b.poster != blank -%}
                {%- render 'responsive-image', image: b.poster, max: 600, sizes: '280px', class: 'vrev__poster' -%}
              {%- else -%}
                <div class="vrev__art">{%- render 'cosmetic-art', name: arts[i], tone: tones[i] -%}</div>
              {%- endif -%}
              <span class="vrev__shade" aria-hidden="true"></span>
              {%- if b.handle != blank -%}<span class="vrev__handle glass">{% render 'icon', name: 'tiktok', size: 13 %} {{ b.handle | escape }}</span>{%- endif -%}
              {%- if b.video != blank or b.video_url != blank -%}
                <button class="vrev__play glass" type="button" data-vrev-play aria-label="{{ 'sections.play_video' | t }}">{% render 'icon', name: 'play', size: 18 %}</button>
                <button class="vrev__mute glass" type="button" data-vrev-mute aria-pressed="false" aria-label="{{ 'sections.unmute' | t }}" data-label-mute="{{ 'sections.mute' | t }}" data-label-unmute="{{ 'sections.unmute' | t }}">
                  <svg class="vrev__icon-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="m22 9-6 6M16 9l6 6"/></svg>
                  <svg class="vrev__icon-sound" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg>
                </button>
              {%- endif -%}
              {%- if b.quote != blank -%}<p class="vrev__quote">“{{ b.quote | escape }}”</p>{%- endif -%}
            </div>
            {%- if b.product != blank -%}
              {%- assign p = b.product -%}
              <a class="vrev__product" href="{{ p.url }}">
                <span class="vrev__thumb">
                  {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 48, height: 48 }}{%- else -%}{%- render 'cosmetic-art', name: arts[i], tone: tones[i] -%}{%- endif -%}
                </span>
                <span class="vrev__info"><span class="vrev__title">{{ p.title | escape }}</span>{%- render 'price', product: p -%}</span>
                <span class="vrev__go">{% render 'icon', name: 'arrow-right', size: 15 %}</span>
              </a>
            {%- elsif b.caption != blank -%}
              <p class="vrev__caption">{{ b.caption | escape }}</p>
            {%- endif -%}
          </article>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</video-reviews>

{% schema %}
{
  "name": "t:sections.video-reviews.name",
  "class": "section-video-reviews",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.video-reviews.settings.kicker.label",
      "default": "#LumiereRitual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.video-reviews.settings.heading.label",
      "default": "Seen on your feed."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.video-reviews.settings.text.label",
      "default": "<p>Real routines from our community — tap to play.</p>"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.video-reviews.settings.autoplay.label",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:sections.video-reviews.settings.paragraph__5.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.video-reviews.settings.color_scheme.label",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "t:sections.video-reviews.blocks.video.name",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.video-reviews.blocks.video.settings.video.label"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "t:sections.video-reviews.blocks.video.settings.video_url.label"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "t:sections.video-reviews.blocks.video.settings.poster.label"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "t:sections.video-reviews.blocks.video.settings.handle.label",
          "default": "@yourcustomer"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "t:sections.video-reviews.blocks.video.settings.quote.label"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.video-reviews.blocks.video.settings.product.label"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.video-reviews.blocks.video.settings.caption.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.video-reviews.presets.presets__1.name",
      "blocks": [
        {
          "type": "video",
          "settings": {
            "quote": "My skin has never looked this calm."
          }
        },
        {
          "type": "video",
          "settings": {
            "quote": "The texture is unreal."
          }
        },
        {
          "type": "video",
          "settings": {
            "quote": "Glow, no filter."
          }
        },
        {
          "type": "video",
          "settings": {
            "quote": "Part of my AM ritual now."
          }
        },
        {
          "type": "video"
        }
      ]
    }
  ]
}
{% endschema %}
