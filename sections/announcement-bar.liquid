{%- assign s = section.settings -%}
{%- if s.enable and section.blocks.size > 0 -%}
  <announcement-bar class="announce color-{{ s.color_scheme }}{% if s.caps %} announce--caps{% endif %}" data-interval="{{ s.interval | times: 1000 }}" {{ section.shopify_attributes }}>
    <div class="announce__inner page-width">
      {%- if section.blocks.size > 1 -%}
        <button class="announce__nav" type="button" data-announce="prev" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 14 %}</button>
      {%- endif -%}
      <div class="announce__track" aria-live="polite">
        {%- for block in section.blocks -%}
          <p class="announce__item{% if forloop.first %} is-active{% endif %}"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}{%- render 'icon', name: block.settings.icon, size: 14 -%}{%- endif -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              <span>{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <button class="announce__nav" type="button" data-announce="next" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right', size: 14 %}</button>
      {%- endif -%}
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "class": "section-announcement",
  "max_blocks": 5,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "t:sections.announcement-bar.settings.enable.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.announcement-bar.settings.color_scheme.label",
      "default": "scheme-6"
    },
    {
      "type": "checkbox",
      "id": "caps",
      "label": "t:sections.announcement-bar.settings.caps.label",
      "default": false
    },
    {
      "type": "range",
      "id": "interval",
      "label": "t:sections.announcement-bar.settings.interval.label",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label",
          "default": "Complimentary shipping on orders over $75"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.icon.label",
          "options": [
            {
              "value": "none",
              "label": "t:sections.announcement-bar.blocks.announcement.settings.icon.options__1.label"
            },
            {
              "value": "sparkle",
              "label": "t:sections.announcement-bar.blocks.announcement.settings.icon.options__2.label"
            },
            {
              "value": "truck",
              "label": "t:sections.announcement-bar.blocks.announcement.settings.icon.options__3.label"
            },
            {
              "value": "gift",
              "label": "t:sections.announcement-bar.blocks.announcement.settings.icon.options__4.label"
            },
            {
              "value": "leaf",
              "label": "t:sections.announcement-bar.blocks.announcement.settings.icon.options__5.label"
            },
            {
              "value": "return",
              "label": "t:sections.announcement-bar.blocks.announcement.settings.icon.options__6.label"
            },
            {
              "value": "tag",
              "label": "t:sections.announcement-bar.blocks.announcement.settings.icon.options__7.label"
            }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.presets__1.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
