{%- assign s = section.settings -%}
{%- if s.enable and section.blocks.size > 0 -%}
  <announcement-bar class="announce color-{{ s.color_scheme }}{% if s.caps %} announce--caps{% endif %}" data-interval="{{ s.interval | times: 1000 }}" {{ section.shopify_attributes }}>
    <div class="announce__inner page-width">
      {%- if section.blocks.size > 1 -%}
        <button class="announce__nav" type="button" data-announce="prev" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 14 %}</button>
      {%- endif -%}
      <div class="announce__track" aria-live="polite">
        {%- for block in section.blocks -%}
          <p class="announce__item{% if forloop.first %} is-active{% endif %}"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}{%- render 'icon', name: block.settings.icon, size: 14 -%}{%- endif -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              <span>{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <button class="announce__nav" type="button" data-announce="next" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right', size: 14 %}</button>
      {%- endif -%}
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 5,
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Show announcement bar", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-6" },
    { "type": "checkbox", "id": "caps", "label": "Uppercase text", "default": false },
    { "type": "range", "id": "interval", "label": "Rotate every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Complimentary shipping on orders over $75" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "truck", "label": "Delivery" },
            { "value": "gift", "label": "Gift" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "return", "label": "Returns" },
            { "value": "tag", "label": "Tag" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "announcement" }] }]
}
{% endschema %}
