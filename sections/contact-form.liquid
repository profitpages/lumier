{%- assign s = section.settings -%}
<section class="section section--tight color-{{ s.color_scheme }}">
  <div class="page-width page-width--narrow">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text -%}
    {%- form 'contact', class: 'panel-card form-grid' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-msg form-msg--ok" role="status" tabindex="-1" autofocus>{% render 'icon', name: 'check', size: 16 %} {{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-msg form-msg--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form-grid__row">
        <div class="field"><label class="label" for="ContactName">{{ 'customer.name' | t }}</label><input class="input" id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"></div>
        <div class="field"><label class="label" for="ContactEmail">{{ 'customer.email' | t }} <span aria-hidden="true">*</span></label><input class="input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required aria-required="true" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"></div>
      </div>
      <div class="field"><label class="label" for="ContactPhone">{{ 'customer.phone' | t }}</label><input class="input" id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></div>
      <div class="field"><label class="label" for="ContactBody">{{ 'contact.message' | t }}</label><textarea class="input" id="ContactBody" name="contact[body]" rows="6">{{ form.body }}</textarea></div>
      <button class="btn btn--solid" type="submit">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "We'd love to hear from you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Say hello." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about a formula, an order, or your routine? We reply within one business day.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
