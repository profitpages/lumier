{%- comment -%}
  Lumière hero — layered 2.5D stage: glow orb · arch image with champagne slab · two tilted polaroids.
  Layouts: arch (Canva), split (curved-corner image), cover (full-bleed image with overlay).
{%- endcomment -%}
{{ 'section-hero.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign htag = 'h2'
  if section.index == 1
    assign htag = 'h1'
  endif
  assign eager = false
  if section.index <= 2
    assign eager = true
  endif
  assign p1_img = s.polaroid_1 | default: s.polaroid_product_1.featured_media.preview_image
  assign p2_img = s.polaroid_2 | default: s.polaroid_product_2.featured_media.preview_image
-%}
<section class="hero hero--{{ s.layout }} hero--{{ s.height }} hero--align-{{ s.text_align }}{% if s.content_right %} hero--content-right{% endif %} color-{{ s.color_scheme }}" style="--img-pos: {{ s.image_position }}; --hero-overlay: {{ s.overlay | divided_by: 100.0 }};">
  {%- if s.layout == 'cover' -%}
    <div class="hero__bg" aria-hidden="true">
      {%- if s.image != blank -%}
        {%- render 'responsive-image', image: s.image, max: 2400, sizes: '100vw', class: 'hero__bg-img hero__bg-img--desk', eager: eager -%}
        {%- if s.mobile_image != blank -%}{%- render 'responsive-image', image: s.mobile_image, max: 1000, sizes: '100vw', class: 'hero__bg-img hero__bg-img--mob', eager: eager -%}{%- endif -%}
      {%- else -%}
        <div class="hero__bg-art">{%- render 'cosmetic-art', name: 'portrait', tone: 'blush' -%}</div>
      {%- endif -%}
    </div>
  {%- else -%}
    {%- render 'decor', preset: 'hero' -%}
  {%- endif -%}

  <div class="hero__grid page-width">
    <div class="hero__copy">
      {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<{{ htag }} class="display hero__title">{{ s.heading | escape }}</{{ htag }}>{%- endif -%}
      {%- if s.text != blank -%}<div class="hero__text rte">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank or s.button2_label != blank -%}
        <div class="btn-row">
          {%- render 'button', label: s.button_label, url: s.button_link, style: 'solid' -%}
          {%- render 'button', label: s.button2_label, url: s.button2_link, style: 'outline' -%}
        </div>
      {%- endif -%}
    </div>

    {%- unless s.layout == 'cover' -%}
      <div class="hero__art" data-parallax>
        {%- if s.layout == 'arch' -%}
          <div class="hero__frame frame frame--arch has-slab{% if s.mobile_image != blank %} has-mobile{% endif %}">
            {%- render 'responsive-image', image: s.image, max: 1400, sizes: '(min-width: 990px) 34vw, 82vw', class: 'hero__img hero__img--desk', eager: eager, art: 'portrait', tone: 'blush' -%}
            {%- if s.mobile_image != blank -%}{%- render 'responsive-image', image: s.mobile_image, max: 900, sizes: '82vw', class: 'hero__img hero__img--mob', eager: eager -%}{%- endif -%}
          </div>
          {%- if s.show_polaroids -%}
            {%- capture p1 -%}{%- render 'responsive-image', image: p1_img, max: 500, sizes: '170px', art: 'tube', tone: 'linen' -%}{%- endcapture -%}
            {%- capture p2 -%}{%- render 'responsive-image', image: p2_img, max: 500, sizes: '160px', art: 'jar', tone: 'champagne' -%}{%- endcapture -%}
            {%- if s.polaroid_product_1 != blank -%}
              <a class="polaroid polaroid--decor polaroid--float hero__pol hero__pol--1" href="{{ s.polaroid_product_1.url }}" style="--tilt: 5deg;" aria-label="{{ s.polaroid_product_1.title | escape }}">{{ p1 }}</a>
            {%- else -%}
              <span class="polaroid polaroid--decor polaroid--float hero__pol hero__pol--1" style="--tilt: 5deg;" aria-hidden="true">{{ p1 }}</span>
            {%- endif -%}
            {%- if s.polaroid_product_2 != blank -%}
              <a class="polaroid polaroid--decor polaroid--float hero__pol hero__pol--2" href="{{ s.polaroid_product_2.url }}" style="--tilt: -5deg;" aria-label="{{ s.polaroid_product_2.title | escape }}">{{ p2 }}</a>
            {%- else -%}
              <span class="polaroid polaroid--decor polaroid--float hero__pol hero__pol--2" style="--tilt: -5deg;" aria-hidden="true">{{ p2 }}</span>
            {%- endif -%}
          {%- endif -%}
        {%- else -%}
          <div class="hero__frame frame frame--corner has-slab{% if s.mobile_image != blank %} has-mobile{% endif %}">
            {%- render 'responsive-image', image: s.image, max: 1600, sizes: '(min-width: 990px) 46vw, 92vw', class: 'hero__img hero__img--desk', eager: eager, art: 'portrait', tone: 'blush' -%}
            {%- if s.mobile_image != blank -%}{%- render 'responsive-image', image: s.mobile_image, max: 900, sizes: '92vw', class: 'hero__img hero__img--mob', eager: eager -%}{%- endif -%}
          </div>
          {%- if s.caption != blank -%}<span class="caption-chip caption-chip--serif hero__caption">{{ s.caption | escape }}</span>{%- endif -%}
        {%- endif -%}
      </div>
    {%- endunless -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.hero.name",
  "class": "section-hero",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.hero.settings.layout.label",
      "options": [
        {
          "value": "arch",
          "label": "t:sections.hero.settings.layout.options__1.label"
        },
        {
          "value": "split",
          "label": "t:sections.hero.settings.layout.options__2.label"
        },
        {
          "value": "cover",
          "label": "t:sections.hero.settings.layout.options__3.label"
        }
      ],
      "default": "arch"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.settings.image.label",
      "info": "t:sections.hero.settings.image.info"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.hero.settings.mobile_image.label",
      "info": "t:sections.hero.settings.mobile_image.info"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.hero.settings.image_position.label",
      "options": [
        {
          "value": "center top",
          "label": "t:sections.hero.settings.image_position.options__1.label"
        },
        {
          "value": "center center",
          "label": "t:sections.hero.settings.image_position.options__2.label"
        },
        {
          "value": "center bottom",
          "label": "t:sections.hero.settings.image_position.options__3.label"
        },
        {
          "value": "left center",
          "label": "t:sections.hero.settings.image_position.options__4.label"
        },
        {
          "value": "right center",
          "label": "t:sections.hero.settings.image_position.options__5.label"
        }
      ],
      "default": "center top"
    },
    {
      "type": "header",
      "content": "t:sections.hero.settings.header__5.content"
    },
    {
      "type": "checkbox",
      "id": "show_polaroids",
      "label": "t:sections.hero.settings.show_polaroids.label",
      "default": true
    },
    {
      "type": "product",
      "id": "polaroid_product_1",
      "label": "t:sections.hero.settings.polaroid_product_1.label",
      "info": "t:sections.hero.settings.polaroid_product_1.info"
    },
    {
      "type": "image_picker",
      "id": "polaroid_1",
      "label": "t:sections.hero.settings.polaroid_1.label"
    },
    {
      "type": "product",
      "id": "polaroid_product_2",
      "label": "t:sections.hero.settings.polaroid_product_2.label"
    },
    {
      "type": "image_picker",
      "id": "polaroid_2",
      "label": "t:sections.hero.settings.polaroid_2.label"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:sections.hero.settings.caption.label",
      "default": "A daily ritual, beautifully considered."
    },
    {
      "type": "header",
      "content": "t:sections.hero.settings.header__12.content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.hero.settings.kicker.label",
      "default": "A luminous daily practice"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.settings.heading.label",
      "default": "Rituals, refined."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.hero.settings.text.label",
      "default": "<p>High-performance beauty essentials designed for luminous everyday living.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero.settings.button_label.label",
      "default": "Shop bestsellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero.settings.button_link.label"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "t:sections.hero.settings.button2_label.label",
      "default": "Discover the ritual"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "t:sections.hero.settings.button2_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.hero.settings.header__20.content"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:sections.hero.settings.text_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.hero.settings.text_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.hero.settings.text_align.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "content_right",
      "label": "t:sections.hero.settings.content_right.label",
      "default": false
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.hero.settings.height.label",
      "options": [
        {
          "value": "md",
          "label": "t:sections.hero.settings.height.options__1.label"
        },
        {
          "value": "lg",
          "label": "t:sections.hero.settings.height.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.hero.settings.height.options__3.label"
        }
      ],
      "default": "md"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "t:sections.hero.settings.overlay.label",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.hero.settings.color_scheme.label",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.presets.presets__1.name"
    }
  ]
