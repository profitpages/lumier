        },
        {
          "type": "checkbox",
          "id": "show_dot",
          "label": "t:sections.multirow.blocks.row.settings.show_dot.label",
          "default": false
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.multirow.blocks.row.settings.kicker.label",
