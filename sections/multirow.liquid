{%- comment -%}
  Multirow — alternating image + text rows in Lumière's frame language.
  Each row picks its frame (curved corner, arch + slab, offset block, square), optional caption chip,
  accent dot and an optional featured product.
{%- endcomment -%}
{{ 'section-lumiere-more.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign arts = 'portrait,serum,jar,pump,swatch,tube' | split: ','
-%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: s.heading_align -%}
    <div class="lrow lrow--{{ s.style }}{% if s.alternate %} lrow--alt{% endif %}{% if s.image_right %} lrow--start-right{% endif %}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign i = forloop.index0 | modulo: 6
          assign p = b.product
          assign img = b.image | default: p.featured_media.preview_image
          assign frame = 'frame--corner has-shadow'
          case b.frame
            when 'arch'
              assign frame = 'frame--arch has-slab'
            when 'offset'
              assign frame = 'frame--square'
            when 'square'
              assign frame = 'frame--square has-shadow'
          endcase
        -%}
        <article class="lrow__row lrow__row--{{ b.frame }}{% if s.style == 'panels' %} color-{{ b.color_scheme }}{% endif %}" data-reveal {{ block.shopify_attributes }}>
          <div class="lrow__media lrow__media--{{ s.ratio }}">
            {%- if b.frame == 'offset' -%}<span class="lrow__slab" aria-hidden="true"></span>{%- endif -%}
            <div class="lrow__frame frame {{ frame }}">
              {%- render 'responsive-image', image: img, max: 1400, sizes: '(min-width: 990px) 45vw, 92vw', class: 'lrow__img', art: arts[i], tone: 'linen' -%}
            </div>
            {%- if b.show_dot and settings.decor_enable -%}<span class="dot-accent lrow__dot" aria-hidden="true"></span>{%- endif -%}
            {%- if b.caption != blank -%}<span class="caption-chip caption-chip--serif lrow__caption">{{ b.caption | escape }}</span>{%- endif -%}
          </div>
          <div class="lrow__copy">
            {%- if s.numbered -%}<span class="lrow__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>{%- endif -%}
            {%- if b.kicker != blank -%}<p class="kicker">{{ b.kicker | escape }}</p>{%- endif -%}
            {%- if b.heading != blank -%}<h3 class="h2 lrow__title">{{ b.heading | escape }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<div class="rte lrow__text">{{ b.text }}</div>{%- endif -%}
            {%- if p != blank -%}
              <a class="lrow__product" href="{{ p.url }}">
                <span class="lrow__product-title">{{ p.title | escape }}</span>
                {%- render 'price', product: p -%}
              </a>
            {%- endif -%}
            {%- if b.button_label != blank -%}
              {%- assign row_link = b.button_link | default: p.url -%}
              {%- render 'button', label: b.button_label, url: row_link, style: b.button_style -%}
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.multirow.name",
  "class": "section-multirow",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
