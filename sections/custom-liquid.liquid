<div class="section color-{{ section.settings.color_scheme }}{% if section.settings.no_padding %} section--flush{% endif %}">
  <div class="{% if section.settings.contain %}page-width{% endif %}">
    {{ section.settings.custom_liquid }}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.custom-liquid.name",
  "class": "section-custom-liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:sections.custom-liquid.settings.custom_liquid.label",
      "info": "t:sections.custom-liquid.settings.custom_liquid.info"
    },
    {
      "type": "checkbox",
      "id": "contain",
      "label": "t:sections.custom-liquid.settings.contain.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "no_padding",
      "label": "t:sections.custom-liquid.settings.no_padding.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.custom-liquid.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-liquid.presets.presets__1.name"
    }
  ]
}
{% endschema %}
