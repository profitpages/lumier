{%- comment -%} Benefits / Key benefits — soft panel with frosted feature cards. Used on home and product pages. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section color-{{ s.section_scheme }}">
  <div class="page-width">
    <div class="{% if s.style == 'panel' %}panel color-{{ s.color_scheme }}{% endif %} benefits benefits--{{ s.style }}">
      {%- if s.style == 'standard' -%}
        <header class="benefits__head">
          {%- if s.kicker != blank -%}<p class="kicker kicker--accent">{{ s.kicker | escape }}</p>{%- endif -%}
          <div class="benefits__statement">
            {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
            {%- if s.text != blank -%}<div class="rte sec-head__text">{{ s.text }}</div>{%- endif -%}
          </div>
        </header>
      {%- else -%}
        {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text -%}
      {%- endif -%}
      <ul class="feature-grid" role="list" style="--cols: {{ s.columns }};">
        {%- for block in section.blocks -%}
          <li class="feature" data-reveal {{ block.shopify_attributes }}>
            <span class="feature__icon">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 28, height: 28 }}
              {%- else -%}
                {%- render 'icon', name: block.settings.icon, size: 22 -%}
              {%- endif -%}
            </span>
            {%- if block.settings.title != blank -%}<h3 class="feature__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="feature__text rte">{{ block.settings.text }}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

