<section class="section section--tight auth color-scheme-1">
  {%- render 'decor', preset: 'hero' -%}
  <div class="page-width auth__wrap">
    <div class="panel-card auth__card">
      <p class="kicker">{{ 'customer.join' | t }}</p>
      <h1 class="h2">{{ 'customer.create' | t }}</h1>
      {%- form 'create_customer', novalidate: 'novalidate', class: 'form-grid' -%}
        {%- if form.errors -%}<div class="form-msg form-msg--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="form-grid__row">
          <div class="field"><label class="label" for="RegFirst">{{ 'customer.first_name' | t }}</label><input class="input" id="RegFirst" type="text" name="customer[first_name]" autocomplete="given-name"></div>
          <div class="field"><label class="label" for="RegLast">{{ 'customer.last_name' | t }}</label><input class="input" id="RegLast" type="text" name="customer[last_name]" autocomplete="family-name"></div>
        </div>
        <div class="field"><label class="label" for="RegEmail">{{ 'customer.email' | t }}</label><input class="input" id="RegEmail" type="email" name="customer[email]" autocomplete="email" required></div>
        <div class="field"><label class="label" for="RegPassword">{{ 'customer.password' | t }}</label><input class="input" id="RegPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
        <label class="check">
          <input type="checkbox" name="customer[accepts_marketing]" value="true">
          <span class="check__box" aria-hidden="true">{% render 'icon', name: 'check', size: 12 %}</span>
          <span class="check__label">{{ 'customer.marketing' | t }}</span>
        </label>
        <button class="btn btn--solid btn--block" type="submit">{{ 'customer.create' | t }}</button>
      {%- endform -%}
      <p class="auth__alt">{{ 'customer.have_account' | t }} <a href="{{ routes.account_login_url }}">{{ 'customer.log_in' | t }}</a></p>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Register" }
{% endschema %}
