{%- comment -%} Collection tabs — one tab per collection, each showing a product grid (server-rendered, accessible tabs). {%- endcomment -%}
{{ 'section-lumiere.css' | asset_url | stylesheet_tag }}
{{ 'section-lumiere-more.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign uid = 'CTabs-' | append: section.id
-%}
<section class="section color-{{ s.color_scheme }}" style="--cols: {{ s.columns }}; --cols-m: 2;">
  <div class="page-width">
    <tab-set class="ctabs">
      <div class="ctabs__head">
        <div class="sec-head__main">
          {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
        </div>
        <div class="tabs__list ctabs__list" role="tablist" aria-label="{{ s.heading | escape }}">
          {%- for block in section.blocks -%}
            {%- assign c = block.settings.collection -%}
            <button class="tabs__tab ctabs__tab" type="button" role="tab" id="{{ uid }}-tab-{{ forloop.index0 }}" aria-controls="{{ uid }}-panel-{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>{{ block.settings.label | default: c.title | escape }}</button>
          {%- endfor -%}
        </div>
      </div>
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <div class="tabs__panel" role="tabpanel" id="{{ uid }}-panel-{{ forloop.index0 }}" aria-labelledby="{{ uid }}-tab-{{ forloop.index0 }}" data-tab-pane="{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %}>
          <ul class="product-grid" role="list">
            {%- if c != blank and c.products_count > 0 -%}
              {%- for product in c.products limit: s.limit -%}
                <li class="product-grid__item">{%- render 'product-card', product: product, style: s.card_style, section_id: section.id -%}</li>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}<li class="product-grid__item">{%- render 'product-card', product: blank, style: s.card_style -%}</li>{%- endfor -%}
            {%- endif -%}
          </ul>
          {%- if c != blank -%}
            <div class="ctabs__more"><a class="link-underline" href="{{ c.url }}">{{ s.link_label | escape }} {{ c.title | escape }}</a></div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </tab-set>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection-tabs.name",
  "class": "section-collection-tabs",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.collection-tabs.settings.kicker.label",
      "default": "Shop the edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collection-tabs.settings.heading.label",
      "default": "Find your category."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:sections.collection-tabs.settings.limit.label",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.collection-tabs.settings.columns.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:sections.collection-tabs.settings.card_style.label",
      "options": [
        {
          "value": "editorial",
          "label": "t:sections.collection-tabs.settings.card_style.options__1.label"
        },
        {
          "value": "label",
          "label": "t:sections.collection-tabs.settings.card_style.options__2.label"
        },
        {
          "value": "rounded",
          "label": "t:sections.collection-tabs.settings.card_style.options__3.label"
        },
        {
          "value": "gallery",
          "label": "t:sections.collection-tabs.settings.card_style.options__4.label"
        }
      ],
      "default": "gallery"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.collection-tabs.settings.link_label.label",
      "default": "Shop all"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.collection-tabs.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection-tabs.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection-tabs.blocks.collection.settings.collection.label"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.collection-tabs.blocks.collection.settings.label.label",
          "info": "t:sections.collection-tabs.blocks.collection.settings.label.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-tabs.presets.presets__1.name",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "label": "Skincare"
          }
        },
        {
          "type": "collection",
          "settings": {
            "label": "Makeup"
          }
        },
        {
          "type": "collection",
          "settings": {
            "label": "Body"
          }
        }
      ]
    }
  ]
}
{% endschema %}
