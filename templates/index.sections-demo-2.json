        "button_label": "See my ritual",
        "color_scheme": "scheme-3",
        "section_scheme": "scheme-1"
      },
      "blocks": {
        "skin_1": {
          "type": "skin",
          "settings": {
            "label": "Dry",
            "note": "Tight, craves comfort",
            "icon": "drop",
            "param": "filter.p.m.custom.skin_type=Dry"
          }
        },
        "skin_2": {
          "type": "skin",
          "settings": {
            "label": "Oily",
            "note": "Shiny by midday",
            "icon": "sun",
            "param": "filter.p.m.custom.skin_type=Oily"
          }
        },
        "skin_3": {
          "type": "skin",
          "settings": {
            "label": "Combination",
            "note": "A bit of both",
            "icon": "leaf",
            "param": "filter.p.m.custom.skin_type=Combination"
          }
        },
        "skin_4": {
          "type": "skin",
          "settings": {
            "label": "Sensitive",
            "note": "Reacts easily",
            "icon": "heart",
            "param": "filter.p.m.custom.skin_type=Sensitive"
          }
        },
        "concern_5": {
          "type": "concern",
          "settings": {
            "label": "Dullness",
            "icon": "sun",
            "param": "filter.p.product_type=Serum"
          }
        },
        "concern_6": {
          "type": "concern",
          "settings": {
            "label": "Fine lines",
            "icon": "sparkle",
            "param": "filter.p.product_type=Treatment"
          }
        },
        "concern_7": {
          "type": "concern",
          "settings": {
            "label": "Dehydration",
            "icon": "drop",
            "param": "filter.p.product_type=Moisturiser"
          }
        },
        "concern_8": {
          "type": "concern",
          "settings": {
            "label": "Breakouts",
            "icon": "leaf",
            "param": "filter.p.product_type=Cleanser"
