{
  "sections": {
    "quiz": {
      "type": "skin-quiz",
      "settings": {
        "kicker": "Ritual finder",
        "heading": "Find your ritual in three taps.",
        "text": "<p>Tell us a little about your skin and we'll edit the shelf for you.</p>",
        "q_skin": "How does your skin usually feel?",
        "q_concern": "What would you love to change?",
        "q_budget": "What's your budget?",
