{%- comment -%}
  Lumière placeholder art: fine monoline cosmetic drawings shown wherever an image hasn't been chosen yet.
  Usage: {% render 'cosmetic-art', name: 'serum', tone: 'blush' %}
  names: serum, jar, tube, pump, compact, lipstick, swatch, portrait  ·  tones: blush, linen, champagne
{%- endcomment -%}
{%- liquid
  assign art_name = name | default: 'serum'
  case tone
    when 'champagne', 'peach', 'sand'
      assign art_tone = 'champagne'
    when 'linen', 'lilac', 'sage'
      assign art_tone = 'linen'
    else
      assign art_tone = 'blush'
  endcase
-%}
<span class="cosmo cosmo--{{ art_name }} cosmo-tone--{{ art_tone }}" aria-hidden="true">
  <svg viewBox="0 0 160 200" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" focusable="false">
    <ellipse class="cosmo__floor" cx="80" cy="184" rx="52" ry="6" stroke="none"/>
    {%- case art_name -%}
      {%- when 'jar' -%}
        <rect class="cosmo__fill" x="38" y="96" width="84" height="78" rx="12"/>
        <rect x="38" y="96" width="84" height="78" rx="12"/>
        <rect x="32" y="74" width="96" height="26" rx="6"/>
        <path d="M52 124h56M60 136h40"/>
        <path d="M46 104v58" opacity=".45"/>
      {%- when 'tube' -%}
        <path class="cosmo__fill" d="M58 30h44l-6 120H64z"/>
        <path d="M58 30h44l-6 120H64z"/>
        <path d="M56 30h48" />
        <rect x="64" y="150" width="32" height="26" rx="4"/>
        <path d="M68 70h24M70 82h20"/>
        <path d="M64 40l4 100" opacity=".45"/>
      {%- when 'pump' -%}
        <rect class="cosmo__fill" x="50" y="70" width="60" height="106" rx="14"/>
        <rect x="50" y="70" width="60" height="106" rx="14"/>
        <path d="M70 70V52h20v18M74 52V40h30v8h-14"/>
        <path d="M62 112h36M66 124h28"/>
        <path d="M58 82v80" opacity=".45"/>
      {%- when 'compact' -%}
        <path class="cosmo__fill" d="M30 120h100v38a16 16 0 0 1-16 16H46a16 16 0 0 1-16-16z"/>
        <path d="M30 120h100v38a16 16 0 0 1-16 16H46a16 16 0 0 1-16-16z"/>
        <path d="M34 120a46 40 0 0 1 92 0"/>
        <ellipse cx="80" cy="146" rx="30" ry="12"/>
        <path d="M56 104a26 22 0 0 1 22-18" opacity=".45"/>
      {%- when 'lipstick' -%}
        <path class="cosmo__fill" d="M66 108h28v68H66z"/>
        <path d="M66 108h28v68H66z"/>
        <path d="M68 108V78h24v30"/>
        <path d="M70 78V48l20-12v42"/>
        <path d="M72 120v46" opacity=".45"/>
      {%- when 'swatch' -%}
        <path class="cosmo__fill" d="M28 128c10-26 52-38 82-30 22 6 30 26 14 38-20 16-64 18-86 8-10-4-12-10-10-16z"/>
        <path d="M28 128c10-26 52-38 82-30 22 6 30 26 14 38-20 16-64 18-86 8-10-4-12-10-10-16z"/>
        <circle cx="122" cy="74" r="8"/>
        <circle cx="44" cy="168" r="5"/>
        <path d="M48 124c18-12 44-16 64-10" opacity=".45"/>
      {%- when 'portrait' -%}
        <path class="cosmo__fill" d="M30 180c4-34 24-52 50-52s46 18 50 52z"/>
        <path d="M30 180c4-34 24-52 50-52s46 18 50 52"/>
        <ellipse cx="80" cy="84" rx="26" ry="32"/>
        <path d="M54 80c-2-30 18-46 34-42 18 4 26 22 18 46"/>
        <path d="M54 82c-6 22-4 40 6 50M106 84c4 20 2 36-8 46" opacity=".45"/>
      {%- else -%}
        <rect class="cosmo__fill" x="52" y="84" width="56" height="92" rx="12"/>
        <rect x="52" y="84" width="56" height="92" rx="12"/>
        <path d="M66 84V70h28v14"/>
        <path d="M70 70V44a10 10 0 0 1 20 0v26"/>
        <path d="M62 120h36M66 132h28"/>
        <path d="M60 96v66" opacity=".45"/>
    {%- endcase -%}
  </svg>
</span>
