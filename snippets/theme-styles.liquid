{%- comment -%} Lumière fonts + design tokens (from theme settings and color schemes). {%- endcomment -%}
{%- if settings.use_signature_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap" rel="stylesheet">
  {%- assign heading_family = '"Fraunces", Georgia, serif' -%}
  {%- assign body_family = '"DM Sans", system-ui, sans-serif' -%}
  {%- assign heading_weight = 400 -%}
{%- else -%}
  {%- assign heading_family = settings.type_heading_font.family | append: ', ' | append: settings.type_heading_font.fallback_families -%}
  {%- assign body_family = settings.type_body_font.family | append: ', ' | append: settings.type_body_font.fallback_families -%}
  {%- assign heading_weight = settings.type_heading_font.weight -%}
{%- endif -%}

{%- liquid
  assign shadow_k = settings.shadow_intensity | divided_by: 100.0
  assign btn_radius = settings.radius_button
  if btn_radius >= 40
    assign btn_radius = 999
  endif
-%}

<style>
  {%- unless settings.use_signature_fonts -%}
    {{ settings.type_heading_font | font_face: font_display: 'swap' }}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {%- assign body_bold = settings.type_body_font | font_modify: 'weight', 'bold' -%}
    {{ body_bold | font_face: font_display: 'swap' }}
  {%- endunless -%}

  :root {
    --font-heading: {{ heading_family }};
    --font-heading-weight: {{ heading_weight }};
    --font-body: {{ body_family }};
    --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --body-scale: {{ settings.body_scale | divided_by: 100.0 }};
    --kicker-case: {{ settings.heading_case }};

    --page-width: {{ settings.page_width }}px;
    --section-space: {{ settings.section_spacing }}px;
    --radius-card: {{ settings.radius_card }}px;
    --radius-image: {{ settings.radius_image }}px;
    --radius-btn: {{ btn_radius }}px;

    --shadow-k: {{ shadow_k }};
    --depth: {{ settings.depth }}px;

    --slab: {{ settings.slab_offset }}px;
    --accent-btn: {{ settings.color_accent_button }};
    --accent-btn-label: {{ settings.color_accent_button_label }};
    --blush: {{ settings.color_blush }};
    --linen: {{ settings.color_linen }};
    --champagne: {{ settings.color_champagne }};
    --slab-color: color-mix(in srgb, {{ settings.color_champagne }} 38%, transparent);
    /* aliases used by shared components */
    --orb-1: var(--blush);
    --orb-2: var(--linen);
    --orb-3: var(--champagne);
    --stars: {{ settings.color_stars }};
    --sale: {{ settings.color_sale }};
    --sale-text: {{ settings.color_sale_text }};
  }

  {%- for scheme in settings.color_schemes -%}
    {%- assign c = scheme.settings -%}
    .color-{{ scheme.id }} {
      --bg: {{ c.background }};
      --bg-gradient: {% if c.background_gradient != blank %}{{ c.background_gradient }}{% else %}none{% endif %};
      --text: {{ c.text }};
      --text-rgb: {{ c.text.red }}, {{ c.text.green }}, {{ c.text.blue }};
      --muted: {{ c.muted }};
      --accent: {{ c.accent }};
      --card: {{ c.card }};
      --card-rgb: {{ c.card.red }}, {{ c.card.green }}, {{ c.card.blue }};
      --border: {{ c.border }};
      --btn: {{ c.button }};
      --btn-label: {{ c.button_label }};
      --btn-outline: {{ c.secondary_button_label }};
      --shadow-rgb: {{ c.shadow.red }}, {{ c.shadow.green }}, {{ c.shadow.blue }};
      --is-dark: {% if c.background.lightness < 45 %}1{% else %}0{% endif %};
    }
  {%- endfor -%}
</style>
