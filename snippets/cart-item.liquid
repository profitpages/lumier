{%- comment -%} One cart line. Usage: {% render 'cart-item', item: item, index: forloop.index, prefix: 'Drawer' %} {%- endcomment -%}
<li class="cart-line" data-line="{{ index }}">
  <a class="cart-line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{ item.image | image_url: width: 220 | image_tag: loading: 'lazy', alt: '', widths: '110, 220' }}
    {%- else -%}
      {%- render 'cosmetic-art', name: 'jar', tone: 'blush' -%}
    {%- endif -%}
  </a>
  <div class="cart-line__info">
    <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
    {%- unless item.product.has_only_default_variant -%}
      <p class="cart-line__meta">{%- for o in item.options_with_values -%}{{ o.name }}: {{ o.value | escape }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}</p>
    {%- endunless -%}
    {%- for p in item.properties -%}
      {%- assign first_char = p.first | slice: 0 -%}
      {%- if p.last != blank and first_char != '_' -%}<p class="cart-line__meta">{{ p.first }}: {{ p.last }}</p>{%- endif -%}
    {%- endfor -%}
    {%- if item.selling_plan_allocation -%}<p class="cart-line__meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>{%- endif -%}
    {%- for d in item.line_level_discount_allocations -%}
      <p class="cart-line__discount">{% render 'icon', name: 'tag', size: 14 %} {{ d.discount_application.title }} (−{{ d.amount | money }})</p>
    {%- endfor -%}
    <div class="cart-line__controls">
      {%- assign qty_id = prefix | append: 'Qty-' | append: index -%}
      {%- render 'quantity-input', id: qty_id, name: 'updates[]', value: item.quantity, min: 0, line: index, small: true, label: item.product.title -%}
      <button type="button" class="cart-line__remove" data-cart-remove="{{ index }}" aria-label="{{ 'cart.remove_title' | t: title: item.title | escape }}">{{ 'cart.remove' | t }}</button>
    </div>
  </div>
  <div class="cart-line__price">
    {%- if item.original_line_price != item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
    <span>{{ item.final_line_price | money }}</span>
  </div>
</li>
