{%- comment -%}
  Option cards / swatches. Single-option products show the variant metafield custom.option_note as a sub-label (e.g. '1 fl oz', 'Best value'). Paired with the product form via data-form.
  Usage: {% render 'variant-picker', product: product, form_id: 'x', uid: section.id %}
{%- endcomment -%}
{%- unless product.has_only_default_variant -%}
  <variant-picker class="variants" data-variant-picker data-form="{{ form_id }}">
    {%- for option in product.options_with_values -%}
      {%- assign has_swatch = false -%}
      {%- for value in option.values -%}{%- if value.swatch.color or value.swatch.image -%}{%- assign has_swatch = true -%}{%- endif -%}{%- endfor -%}
      <fieldset class="variants__group">
        <legend class="variants__legend">
          <span>{{ option.name | escape }}</span>
          <span class="variants__selected" data-selected-value>{{ option.selected_value | escape }}</span>
        </legend>
        <div class="variants__list{% if has_swatch %} variants__list--swatch{% endif %}">
          {%- for value in option.values -%}
            {%- assign input_id = uid | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
            <input class="visually-hidden variants__input" type="radio" id="{{ input_id }}" name="{{ option.name | escape }}-{{ uid }}" value="{{ value | escape }}"{% if value.selected %} checked{% endif %}>
            <label class="variants__pill{% unless value.available %} is-unavailable{% endunless %}{% if has_swatch %} variants__pill--swatch{% endif %}" for="{{ input_id }}"{% if has_swatch %} title="{{ value | escape }}"{% endif %}>
              {%- if value.swatch.image -%}
                <span class="swatch" style="--swatch: url({{ value.swatch.image | image_url: width: 80 }}) center / cover;" aria-hidden="true"></span>
              {%- elsif value.swatch.color -%}
                <span class="swatch" style="--swatch: {{ value.swatch.color }};" aria-hidden="true"></span>
              {%- endif -%}
              <span class="variants__value{% if has_swatch %} visually-hidden{% endif %}">{{ value | escape }}</span>
              {%- unless has_swatch -%}
                {%- assign opt_note = value.variant.metafields.custom.option_note.value | default: value.variant.metafields.custom.option_note -%}
                {%- if product.options.size == 1 and opt_note != blank -%}<small class="variants__note">{{ opt_note | escape }}</small>{%- endif -%}
              {%- endunless -%}
              {%- unless value.available -%}<span class="visually-hidden"> — {{ 'products.unavailable' | t }}</span>{%- endunless -%}
            </label>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endfor -%}
    <script type="application/json" data-variants>{{ product.variants | json }}</script>
  </variant-picker>
{%- endunless -%}
